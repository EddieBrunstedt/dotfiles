# This file replaces stow's built-in ignore list, so the defaults are repeated.

^/\.git$
^/\.gitignore$
^/\.gitmodules$
^/\.gitattributes$

^/README.*$
^/LICENSE.*$
^/COPYING$

^/justfile$
^/\.stowrc$
^/\.stow-local-ignore$

# Root-owned; installed by `just install-session`
^/system$

# Read from the repo by `pkgs`, not linked into $HOME
^/packages$
