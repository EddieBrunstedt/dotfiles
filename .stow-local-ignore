# Filenames stow should skip in this package (one regex per line).
# Defining this file replaces stow's built-in defaults, so list them too.

# Version control
^/\.git$
^/\.gitignore$
^/\.gitmodules$
^/\.gitattributes$

# Repo metadata
^/README.*$
^/LICENSE.*$
^/COPYING$

# This repo's own setup files
^/justfile$
^/\.stowrc$
^/\.stow-local-ignore$

# Root-owned files. These do not belong in $HOME and are not symlinked;
# `just install-session` copies them into place.
^/system$

# Template only — the real applist-machine is what gets symlinked
^/\.config/applist-machine\.example$
