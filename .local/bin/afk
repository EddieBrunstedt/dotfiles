#!/bin/sh

list="1 - Lock\n2 - Hibernate\n3 - Reboot\n4 - Poweroff"

chosen=$(echo -e "$list" | dmenu -i -l 6 -fn monospace-12)

[ "$chosen" != "" ] || exit

case $chosen in
  "1 - Lock")
      sudo gpgconf --reload gpg-agent; betterlockscreen -l;;

  "2 - Hibernate")
      sudo gpgconf --reload gpg-agent; betterlockscreen -l; systemctl suspend;;

  "3 - Reboot")
      sudo poweroff --reboot;;

  "4 - Poweroff")
      sudo poweroff;;

esac
