#!/usr/bin/env bash

set -euo pipefail

APPLIST="${APPLIST:-$HOME/.config/applist}"
APPLIST_AUR="${APPLIST_AUR:-$HOME/.config/applist-aur}"
APPLIST_LOCAL="${APPLIST_LOCAL:-$HOME/.config/applist-local}"
APPLIST_OPTDEPS="${APPLIST_OPTDEPS:-$HOME/.config/applist-optdeps}"
# Gitignored and optional.
APPLIST_MACHINE="${APPLIST_MACHINE:-$HOME/.config/applist-machine}"

audit=false
fix_explicit=false
json=false
leaf=false
no_color=false
strict=false

usage() {
	cat <<'EOF'
Usage: package_report [OPTIONS]

Compare the installed system against the official, AUR, local-build, machine
and optional-dependency applists in both directions: packages installed but
not listed, and packages listed but not installed (or installed only as a
dependency). Also reports orphans. The default report is local-only and does
not refresh package databases or contact the AUR.

Entries in applist-local are packages built by hand that exist in no
repository, so --audit does not try to resolve them.

applist-machine holds hardware-, boot-, firmware- and greeter-specific
packages. Its contents differ per machine, so it is gitignored and optional;
only applist-machine.example is committed. Nothing installs from it — like
applist-local it exists so its entries count as tracked.

applist-optdeps holds packages kept on purpose as optional dependencies of
something installed (pacman's "Optional For"). They stay installed as
dependencies, so once nothing lists them as optional they become orphans.
Any other package installed only as an optional dependency is reported as
unlisted.

Options:
  --audit          Also check whether listed packages moved between
                   repositories or disappeared (uses the local sync DB and
                   contacts the AUR)
  --leaf           Check explicit leaf packages (pacman -Qqet) instead of all
                   explicitly installed packages (pacman -Qqe). Only affects
                   the installed-but-not-listed check.
  --fix-explicit   Mark every listed package that is currently installed as a
                   dependency with 'pacman -D --asexplicit' (needs root)
  --json           Emit machine-readable JSON
  --no-color       Disable colored output
  --strict         Exit with status 1 when the report finds an issue
  -h, --help       Show this help
EOF
}

while (($#)); do
	case "$1" in
	--audit) audit=true ;;
	--fix-explicit) fix_explicit=true ;;
	--leaf) leaf=true ;;
	--json) json=true ;;
	--no-color) no_color=true ;;
	--strict) strict=true ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf 'Error: unknown option: %s\n\n' "$1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

if ! command -v pacman >/dev/null 2>&1; then
	printf 'Error: pacman is required.\n' >&2
	exit 2
fi

for file in "$APPLIST" "$APPLIST_AUR" "$APPLIST_LOCAL" "$APPLIST_OPTDEPS"; do
	if [[ ! -f $file ]]; then
		printf 'Error: %s not found.\n' "$file" >&2
		exit 2
	fi
done

if $audit && ! command -v paru >/dev/null 2>&1; then
	printf 'Error: paru is required for --audit.\n' >&2
	exit 2
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

if $json || $no_color || [[ ! -t 1 ]] || [[ -v NO_COLOR ]]; then
	RED=''
	GREEN=''
	YELLOW=''
	BOLD=''
	DIM=''
	NC=''
fi

declare -a official_packages=()
declare -a aur_packages=()
declare -a local_packages=()
declare -a machine_packages=()
declare -a optdeps_packages=()
declare -a duplicate_official=()
declare -a duplicate_aur=()
declare -a duplicate_local=()
declare -a duplicate_machine=()
declare -a duplicate_optdeps=()
declare -a overlap_packages=()
declare -A official_list_set=()
declare -A aur_list_set=()
# Used indirectly through load_applist's nameref.
# shellcheck disable=SC2034
declare -A local_list_set=()
# shellcheck disable=SC2034
declare -A machine_list_set=()
declare -A optdeps_list_set=()
declare -A tracked_set=()
input_errors=0

trim_whitespace() {
	local value=$1
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	printf '%s' "$value"
}

load_applist() {
	local file=$1
	local list_name=$2
	local array_name=$3
	local set_name=$4
	local duplicate_name=$5
	local raw package line_number=0
	local -n packages_ref=$array_name
	local -n set_ref=$set_name
	local -n duplicates_ref=$duplicate_name

	while IFS= read -r raw || [[ -n $raw ]]; do
		((++line_number))
		package=${raw%%#*}
		package=$(trim_whitespace "$package")
		[[ -z $package ]] && continue

		if [[ ! $package =~ ^[[:alnum:]@_+][[:alnum:]@._+-]*$ ]]; then
			printf 'Error: invalid package name in %s at line %d: %s\n' \
				"$file" "$line_number" "$package" >&2
			input_errors=1
			continue
		fi

		if [[ ${set_ref[$package]+present} ]]; then
			duplicates_ref+=("$package")
			continue
		fi

		packages_ref+=("$package")
		set_ref["$package"]=1
		tracked_set["$package"]=$list_name
	done <"$file"
}

load_applist "$APPLIST" official official_packages official_list_set duplicate_official
load_applist "$APPLIST_AUR" aur aur_packages aur_list_set duplicate_aur
load_applist "$APPLIST_LOCAL" local local_packages local_list_set duplicate_local
load_applist "$APPLIST_OPTDEPS" optdeps optdeps_packages optdeps_list_set duplicate_optdeps
if [[ -f $APPLIST_MACHINE ]]; then
	load_applist "$APPLIST_MACHINE" machine machine_packages machine_list_set duplicate_machine
fi

if ((input_errors)); then
	exit 2
fi

for package in "${aur_packages[@]}"; do
	if [[ ${official_list_set[$package]+present} ]]; then
		overlap_packages+=("$package")
	fi
done

for package in "${local_packages[@]}"; do
	if [[ ${official_list_set[$package]+present} || ${aur_list_set[$package]+present} ]]; then
		overlap_packages+=("$package")
	fi
done

for package in "${machine_packages[@]}"; do
	if [[ ${official_list_set[$package]+present} || ${aur_list_set[$package]+present} ||
		${local_list_set[$package]+present} ]]; then
		overlap_packages+=("$package")
	fi
done

for package in "${optdeps_packages[@]}"; do
	if [[ ${official_list_set[$package]+present} || ${aur_list_set[$package]+present} ||
		${local_list_set[$package]+present} || ${machine_list_set[$package]+present} ]]; then
		overlap_packages+=("$package")
	fi
done

query_args=(-Qqe)
untracked_label='Untracked'
selection_mode='explicit'
if $leaf; then
	query_args=(-Qqet)
	untracked_label='Untracked leaves'
	selection_mode='leaf'
fi

if ! selected_output=$(pacman "${query_args[@]}"); then
	printf 'Error: pacman %s failed.\n' "${query_args[*]}" >&2
	exit 2
fi

if ! foreign_output=$(pacman -Qqm); then
	printf 'Error: pacman -Qqm failed.\n' >&2
	exit 2
fi

if ! installed_output=$(pacman -Qq); then
	printf 'Error: pacman -Qq failed.\n' >&2
	exit 2
fi

if ! explicit_output=$(pacman -Qqe); then
	printf 'Error: pacman -Qqe failed.\n' >&2
	exit 2
fi

# pacman exits 1 when there is nothing to report, which is not an error here.
orphan_output=$(pacman -Qqdt || true)
# -tt adds dependencies that something lists only as optional.
optional_output=$(pacman -Qqdtt || true)

declare -a selected_packages=()
declare -a untracked_repository=()
declare -a untracked_foreign=()
declare -a orphan_packages=()
declare -A foreign_set=()
declare -A installed_set=()
declare -A explicit_set=()
declare -A orphan_set=()
declare -A optional_set=()

while IFS= read -r package; do
	[[ -n $package ]] && foreign_set["$package"]=1
done <<<"$foreign_output"

while IFS= read -r package; do
	[[ -n $package ]] && installed_set["$package"]=1
done <<<"$installed_output"

while IFS= read -r package; do
	[[ -n $package ]] && explicit_set["$package"]=1
done <<<"$explicit_output"

while IFS= read -r package; do
	[[ -z $package ]] && continue
	orphan_set["$package"]=1
	# Listed ones are reported as unused optional dependencies instead.
	[[ ${optdeps_list_set[$package]+present} ]] || orphan_packages+=("$package")
done <<<"$orphan_output"

while IFS= read -r package; do
	[[ -n $package ]] && optional_set["$package"]=1
done <<<"$optional_output"

while IFS= read -r package; do
	[[ -z $package ]] && continue
	selected_packages+=("$package")
	if [[ ! ${tracked_set[$package]+present} ]]; then
		if [[ ${foreign_set[$package]+present} ]]; then
			untracked_foreign+=("$package")
		else
			untracked_repository+=("$package")
		fi
	fi
done <<<"$selected_output"

configured_count=${#tracked_set[@]}
selected_count=${#selected_packages[@]}
untracked_count=$((${#untracked_repository[@]} + ${#untracked_foreign[@]}))
tracked_selected_count=$((selected_count - untracked_count))

# Reverse check: is every listed package installed, and installed explicitly?
declare -a listed_missing=()
declare -a listed_as_dependency=()

for package in "${official_packages[@]}" "${aur_packages[@]}" "${local_packages[@]}" \
	"${machine_packages[@]}"; do
	if [[ ! ${installed_set[$package]+present} ]]; then
		listed_missing+=("$package")
	elif [[ ! ${explicit_set[$package]+present} ]]; then
		listed_as_dependency+=("$package")
	fi
done

# applist-optdeps entries should be installed as dependencies that something
# lists only as optional. Anything else installed that way is unlisted.
declare -a optdeps_explicit=()
declare -a optdeps_unused=()
declare -a optdeps_required=()
declare -a optional_unlisted=()

for package in "${optdeps_packages[@]}"; do
	if [[ ! ${installed_set[$package]+present} ]]; then
		listed_missing+=("$package")
	elif [[ ${explicit_set[$package]+present} ]]; then
		optdeps_explicit+=("$package")
	elif [[ ${orphan_set[$package]+present} ]]; then
		optdeps_unused+=("$package")
	elif [[ ! ${optional_set[$package]+present} ]]; then
		optdeps_required+=("$package")
	fi
done

for package in "${!optional_set[@]}"; do
	if [[ ! ${orphan_set[$package]+present} && ! ${optdeps_list_set[$package]+present} ]]; then
		optional_unlisted+=("$package")
	fi
done
if ((${#optional_unlisted[@]})); then
	mapfile -t optional_unlisted < <(printf '%s\n' "${optional_unlisted[@]}" | sort)
fi

optdeps_issue_count=$((${#optdeps_explicit[@]} + ${#optdeps_unused[@]} +
	${#optdeps_required[@]} + ${#optional_unlisted[@]}))

# "optional for …" / "required by …", shown next to the packages that need a decision.
declare -A package_details=()

load_package_details() {
	local line field='' name='' value
	local -A optional_for=() required_by=()

	while IFS= read -r line; do
		if [[ $line =~ ^([A-Za-z][A-Za-z\ ]*[A-Za-z])[[:space:]]*:[[:space:]]?(.*)$ ]]; then
			field=${BASH_REMATCH[1]}
			value=${BASH_REMATCH[2]}
			case $field in
			Name) name=$value ;;
			'Optional For') optional_for["$name"]=$value ;;
			'Required By') required_by["$name"]=$value ;;
			esac
		elif [[ $line == [[:space:]]* ]]; then
			# pacman wraps long fields onto indented lines.
			case $field in
			'Optional For') optional_for["$name"]+=" $line" ;;
			'Required By') required_by["$name"]+=" $line" ;;
			esac
		fi
	done < <(LC_ALL=C pacman -Qi "${optional_unlisted[@]}" "${optdeps_required[@]}")

	local -a names
	for name in "${optional_unlisted[@]}"; do
		read -ra names <<<"${optional_for[$name]:-}"
		package_details["$name"]="optional for $(summarize_names "${names[@]}")"
	done
	for name in "${optdeps_required[@]}"; do
		read -ra names <<<"${required_by[$name]:-}"
		package_details["$name"]="required by $(summarize_names "${names[@]}")"
	done
}

join_by() {
	local separator=$1 first=$2
	shift 2
	printf '%s' "$first" "${@/#/$separator}"
}

# The first three names, then a count: glibc alone is required by hundreds.
summarize_names() {
	if (($# > 3)); then
		printf '%s +%d more' "$(join_by ', ' "${@:1:3}")" $(($# - 3))
	else
		join_by ', ' "$@"
	fi
}

if ((${#optional_unlisted[@]} + ${#optdeps_required[@]})); then
	load_package_details
fi

drift_count=$((${#listed_missing[@]} + ${#listed_as_dependency[@]}))

declare -a fixed_explicit=()

if $fix_explicit && ((${#listed_as_dependency[@]})); then
	pacman_fix=(pacman -D --asexplicit)
	if ((EUID != 0)); then
		if ! command -v sudo >/dev/null 2>&1; then
			printf 'Error: --fix-explicit needs root or sudo.\n' >&2
			exit 2
		fi
		pacman_fix=(sudo "${pacman_fix[@]}")
	fi

	if ! "${pacman_fix[@]}" "${listed_as_dependency[@]}" >/dev/null; then
		printf 'Error: failed to update install reasons.\n' >&2
		exit 2
	fi

	fixed_explicit=("${listed_as_dependency[@]}")
	listed_as_dependency=()
	drift_count=${#listed_missing[@]}
fi

declare -a official_moved_to_aur=()
declare -a aur_moved_to_official=()
declare -a official_missing=()
declare -a aur_missing=()
declare -a audit_query_errors=()
declare -a audit_error_messages=()
aur_query_failed=false

if $audit; then
	if ! repository_output=$(pacman -Slq); then
		printf 'Error: pacman -Slq failed.\n' >&2
		exit 2
	fi

	declare -A repository_set=()
	declare -A aur_available_set=()
	declare -A aur_candidate_set=()
	declare -a aur_candidates=()

	while IFS= read -r package; do
		[[ -n $package ]] && repository_set["$package"]=1
	done <<<"$repository_output"

	for package in "${official_packages[@]}" "${aur_packages[@]}"; do
		if [[ ! ${repository_set[$package]+present} && ! ${aur_candidate_set[$package]+present} ]]; then
			aur_candidates+=("$package")
			aur_candidate_set["$package"]=1
		fi
	done

	if ((${#aur_candidates[@]})); then
		aur_error_file=$(mktemp)
		trap 'rm -f "$aur_error_file"' EXIT
		if ! aur_output=$(LC_ALL=C paru -Si --aur "${aur_candidates[@]}" 2>"$aur_error_file"); then
			aur_query_failed=true
		fi

		while IFS= read -r line; do
			if [[ $line =~ ^Name[[:space:]]*:[[:space:]]*(.+)$ ]]; then
				aur_available_set["${BASH_REMATCH[1]}"]=1
			fi
		done <<<"$aur_output"

		if $aur_query_failed; then
			unexpected_error=false
			saw_not_found=false
			declare -a paru_error_lines=()
			while IFS= read -r line; do
				[[ -z $line ]] && continue
				paru_error_lines+=("$line")
				case "$line" in
				"error: package '"*"' was not found") saw_not_found=true ;;
				*) unexpected_error=true ;;
				esac
			done <"$aur_error_file"

			if ! $unexpected_error && $saw_not_found; then
				aur_query_failed=false
			else
				audit_error_messages=("${paru_error_lines[@]}")
				if ((${#audit_error_messages[@]} == 0)); then
					audit_error_messages=('paru exited unsuccessfully without an error message')
				fi
			fi
		fi

		rm -f "$aur_error_file"
		trap - EXIT
	fi

	for package in "${official_packages[@]}"; do
		if [[ ${repository_set[$package]+present} ]]; then
			continue
		elif [[ ${aur_available_set[$package]+present} ]]; then
			official_moved_to_aur+=("$package")
		elif $aur_query_failed; then
			audit_query_errors+=("$package")
		else
			official_missing+=("$package")
		fi
	done

	for package in "${aur_packages[@]}"; do
		if [[ ${repository_set[$package]+present} ]]; then
			aur_moved_to_official+=("$package")
		elif [[ ${aur_available_set[$package]+present} ]]; then
			continue
		elif $aur_query_failed; then
			audit_query_errors+=("$package")
		else
			aur_missing+=("$package")
		fi
	done
fi

json_quote() {
	local value=$1
	value=${value//\\/\\\\}
	value=${value//\"/\\\"}
	value=${value//$'\n'/\\n}
	value=${value//$'\r'/\\r}
	value=${value//$'\t'/\\t}
	printf '"%s"' "$value"
}

json_array() {
	local array_name=$1
	local -n array_ref=$array_name
	local separator='' item
	printf '['
	for item in "${array_ref[@]}"; do
		printf '%s' "$separator"
		json_quote "$item"
		separator=','
	done
	printf ']'
}

print_json_report() {
	printf '{\n'
	printf '  "mode": '
	json_quote "$selection_mode"
	printf ',\n'
	printf '  "configured": {"official": %d, "aur": %d, "local": %d, "machine": %d, "optdeps": %d, "unique": %d},\n' \
		"${#official_packages[@]}" "${#aur_packages[@]}" "${#local_packages[@]}" \
		"${#machine_packages[@]}" "${#optdeps_packages[@]}" "$configured_count"
	printf '  "installed_selected": %d,\n' "$selected_count"
	printf '  "tracked_selected": %d,\n' "$tracked_selected_count"
	printf '  "untracked": {\n'
	printf '    "count": %d,\n' "$untracked_count"
	printf '    "repository": '
	json_array untracked_repository
	printf ',\n    "foreign": '
	json_array untracked_foreign
	printf '\n  },\n'
	printf '  "drift": {\n'
	printf '    "count": %d,\n' "$drift_count"
	printf '    "not_installed": '
	json_array listed_missing
	printf ',\n    "installed_as_dependency": '
	json_array listed_as_dependency
	printf '\n  },\n'
	printf '  "orphans": '
	json_array orphan_packages
	printf ',\n'
	printf '  "optional_dependencies": {\n'
	printf '    "unlisted": '
	json_array optional_unlisted
	printf ',\n    "listed_but_explicit": '
	json_array optdeps_explicit
	printf ',\n    "listed_but_unused": '
	json_array optdeps_unused
	printf ',\n    "listed_but_required": '
	json_array optdeps_required
	printf '\n  },\n'
	printf '  "input_warnings": {\n'
	printf '    "duplicate_official": '
	json_array duplicate_official
	printf ',\n    "duplicate_aur": '
	json_array duplicate_aur
	printf ',\n    "duplicate_local": '
	json_array duplicate_local
	printf ',\n    "duplicate_machine": '
	json_array duplicate_machine
	printf ',\n    "duplicate_optdeps": '
	json_array duplicate_optdeps
	printf ',\n    "in_multiple_lists": '
	json_array overlap_packages
	printf '\n  },\n'
	printf '  "audit": '
	if ! $audit; then
		printf 'null\n'
	else
		printf '{\n'
		printf '    "official_to_aur": '
		json_array official_moved_to_aur
		printf ',\n    "aur_to_official": '
		json_array aur_moved_to_official
		printf ',\n    "missing_from_official_list": '
		json_array official_missing
		printf ',\n    "missing_from_aur_list": '
		json_array aur_missing
		printf ',\n    "query_errors": '
		json_array audit_query_errors
		printf ',\n    "error_messages": '
		json_array audit_error_messages
		printf '\n  }\n'
	fi
	printf '}\n'
}

# Which applists name a package, e.g. "applist and applist-optdeps".
lists_containing() {
	local package=$1
	local -a lists=()
	if [[ ${official_list_set[$package]+present} ]]; then lists+=(applist); fi
	if [[ ${aur_list_set[$package]+present} ]]; then lists+=(applist-aur); fi
	if [[ ${local_list_set[$package]+present} ]]; then lists+=(applist-local); fi
	if [[ ${machine_list_set[$package]+present} ]]; then lists+=(applist-machine); fi
	if [[ ${optdeps_list_set[$package]+present} ]]; then lists+=(applist-optdeps); fi
	join_by ' and ' "${lists[@]}"
}

# A check row collects items with add_item, then print_row prints it: a ✓ when
# empty, otherwise ✗, a count, and one line per package with what is wrong and
# what to do about it.
declare -a row_names=()
declare -a row_details=()
declare -a row_fixes=()

add_item() {
	row_names+=("$1")
	row_details+=("${2:-}")
	row_fixes+=("${3:-}")
}

print_row() {
	local label=$1 hint=${2:-} mark=${3:-✗} color=${4:-$YELLOW}
	local i name_width=0 detail_width=0 fix line

	if ((${#row_names[@]} == 0)); then
		printf '  %b✓%b %s\n' "$GREEN" "$NC" "$label"
		return 0
	fi

	printf '  %b%s%b %-16s%b%d%b\n' "$color" "$mark" "$NC" "$label" "$color" "${#row_names[@]}" "$NC"
	for i in "${!row_names[@]}"; do
		if ((${#row_names[i]} > name_width)); then name_width=${#row_names[i]}; fi
		if ((${#row_details[i]} > detail_width)); then detail_width=${#row_details[i]}; fi
	done
	for i in "${!row_names[@]}"; do
		fix=${row_fixes[i]:+  → ${row_fixes[i]}}
		# Padding sits outside the colour codes so a line without a fix can drop it.
		printf -v line '      %-*s  %b%s%b%*s%s' "$name_width" "${row_names[i]}" \
			"$DIM" "${row_details[i]}" "$NC" $((detail_width - ${#row_details[i]})) '' "$fix"
		[[ -n $fix ]] || line=${line%"${line##*[! ]}"}
		printf '%s\n' "$line"
	done
	if [[ -n $hint ]]; then
		printf '      → %s\n' "$hint"
	fi

	row_names=()
	row_details=()
	row_fixes=()
}

print_text_report() {
	local package message

	printf '%bPackages%b  %d listed %b· %d official · %d AUR · %d local · %d machine · %d optdeps%b\n\n' \
		"$BOLD" "$NC" "$configured_count" "$DIM" "${#official_packages[@]}" "${#aur_packages[@]}" \
		"${#local_packages[@]}" "${#machine_packages[@]}" "${#optdeps_packages[@]}" "$NC"

	for package in "${untracked_repository[@]}"; do
		add_item "$package" 'repository' 'add to applist'
	done
	for package in "${untracked_foreign[@]}"; do
		add_item "$package" 'foreign' 'add to applist-aur or applist-local'
	done
	print_row "$untracked_label"

	for package in "${listed_missing[@]}"; do
		add_item "$package" "in $(lists_containing "$package")"
	done
	print_row 'Not installed' 'install it, or drop it from the list'

	if ((${#fixed_explicit[@]})); then
		for package in "${fixed_explicit[@]}"; do
			add_item "$package" 'marked explicit'
		done
		print_row 'Not explicit' '' '✓' "$GREEN"
	else
		for package in "${listed_as_dependency[@]}"; do
			add_item "$package" "in $(lists_containing "$package")"
		done
		print_row 'Not explicit' 'package_report --fix-explicit'
	fi

	for package in "${orphan_packages[@]}"; do
		add_item "$package"
	done
	print_row 'Orphans' 'pacman -Qqdt | sudo pacman -Rns -'

	for package in "${optional_unlisted[@]}"; do
		add_item "$package" "${package_details[$package]}" 'keep in applist-optdeps, or remove'
	done
	for package in "${optdeps_explicit[@]}"; do
		add_item "$package" 'listed, but explicit' "sudo pacman -D --asdeps $package"
	done
	for package in "${optdeps_unused[@]}"; do
		add_item "$package" 'listed, but nothing uses it' 'remove, and drop it from applist-optdeps'
	done
	for package in "${optdeps_required[@]}"; do
		add_item "$package" "listed, but ${package_details[$package]}" 'drop it from applist-optdeps'
	done
	print_row 'Optional deps'

	# Only shown when something is wrong with the lists themselves.
	for package in "${duplicate_official[@]}"; do add_item "$package" 'twice in applist'; done
	for package in "${duplicate_aur[@]}"; do add_item "$package" 'twice in applist-aur'; done
	for package in "${duplicate_local[@]}"; do add_item "$package" 'twice in applist-local'; done
	for package in "${duplicate_machine[@]}"; do add_item "$package" 'twice in applist-machine'; done
	for package in "${duplicate_optdeps[@]}"; do add_item "$package" 'twice in applist-optdeps'; done
	for package in "${overlap_packages[@]}"; do
		add_item "$package" "in $(lists_containing "$package")" 'keep it in one'
	done
	if ((${#row_names[@]})); then
		print_row 'List entries'
	fi

	if $audit; then
		for package in "${official_moved_to_aur[@]}"; do
			add_item "$package" 'in applist, now in the AUR' 'move it to applist-aur'
		done
		for package in "${aur_moved_to_official[@]}"; do
			add_item "$package" 'in applist-aur, now official' 'move it to applist'
		done
		for package in "${official_missing[@]}"; do
			add_item "$package" 'in applist, gone from the repos' 'replace or drop it'
		done
		for package in "${aur_missing[@]}"; do
			add_item "$package" 'in applist-aur, gone from the AUR' 'replace or drop it'
		done
		for package in "${audit_query_errors[@]}"; do
			add_item "$package" 'unknown: the AUR query failed'
		done
		print_row 'Sources'
		for message in "${audit_error_messages[@]}"; do
			printf '      %b%s%b\n' "$RED" "$message" "$NC"
		done
	fi

	printf '\n'
	if ((issue_count == 0)); then
		printf '%bAll in order.%b\n' "$GREEN" "$NC"
	elif ((issue_count == 1)); then
		printf '%b1 issue.%b\n' "$YELLOW" "$NC"
	else
		printf '%b%d issues.%b\n' "$YELLOW" "$issue_count" "$NC"
	fi
}

issue_count=$((untracked_count + drift_count + ${#orphan_packages[@]} + optdeps_issue_count +
	${#duplicate_official[@]} + ${#duplicate_aur[@]} + ${#duplicate_local[@]} +
	${#duplicate_machine[@]} + ${#duplicate_optdeps[@]} + ${#overlap_packages[@]}))
if $audit; then
	issue_count=$((issue_count + ${#official_moved_to_aur[@]} + ${#aur_moved_to_official[@]} +
		${#official_missing[@]} + ${#aur_missing[@]} + ${#audit_query_errors[@]}))
fi

if $json; then
	print_json_report
else
	print_text_report
fi

if $audit && $aur_query_failed; then
	exit 2
fi

if $strict && ((issue_count > 0)); then
	exit 1
fi
