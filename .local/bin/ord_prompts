#!/bin/sh
#Run an ord LLM template against the clipboard, chosen from rofi (Wayland)

# Templates live in ~/.config/ord/templates. `ord run <template> -f=text -b`
# fills the template's `text` placeholder from the clipboard and opens the
# result in the browser as rendered Markdown.
#
# This used to dispatch to ten one-line ord_* wrapper scripts, which existed
# only so this menu had something to name. The template name was the only
# thing that ever varied between them, so it is held here directly instead.
#
# Adding a prompt: drop a template in that directory, add a line to the list
# and a matching case arm, and keep -l in sync with the number of lines.

list='Fix grammar
Get definition
Shorten
Summarize
ELI5
Explain code
Commit message
Summarize logs
Checklist
Improve prompt'

chosen=$(printf '%s\n' "$list" | rofi -dmenu -i -l 10 -p "Ord prompt")

[ "$chosen" != "" ] || exit

case "$chosen" in
    "Fix grammar")    template=grammar ;;
    "Get definition") template=definition ;;
    "Shorten")        template=shorten ;;
    "Summarize")      template=summarize ;;
    "ELI5")           template=eli5 ;;
    "Explain code")   template=explain_code ;;
    "Commit message") template=commit_message ;;
    "Summarize logs") template=summarize_logs ;;
    "Checklist")      template=checklist ;;
    "Improve prompt") template=improve_prompt ;;
    *) exit 1 ;;
esac

exec ord run "$template" -f=text -b
