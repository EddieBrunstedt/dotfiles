#!/bin/sh
# Run an ord template (~/.config/ord/templates) on the clipboard; the result
# replaces it. To add one: a template, a list line and a case arm.

list='Fix grammar
Get definition
Shorten
Summarize
ELI5
Explain code
Commit message
Summarize logs
Checklist
Improve prompt'

chosen=$(printf '%s\n' "$list" | rofi -dmenu -i -no-custom \
    -l "$(printf '%s\n' "$list" | wc -l)" -p "Ord prompt") || exit 0
[ -n "$chosen" ] || exit 0

case "$chosen" in
    "Fix grammar")    template=grammar ;;
    "Get definition") template=definition ;;
    "Shorten")        template=shorten ;;
    "Summarize")      template=summarize ;;
    "ELI5")           template=eli5 ;;
    "Explain code")   template=explain_code ;;
    "Commit message") template=commit_message ;;
    "Summarize logs") template=summarize_logs ;;
    "Checklist")      template=checklist ;;
    "Improve prompt") template=improve_prompt ;;
    *) exit 1 ;;
esac

exec ord run "$template" -f=text -c -n
