#!/bin/bash

# Define arrays for display names and their corresponding commands
display_names=("Fix grammar" "Get definition" "Shorten" "Summarize" "ELI5" "Explain code" "Commit message" "Summarize logs" "Checklist" "Improve prompt")
commands=("ord_grammar" "ord_definition" "ord_shorten" "ord_summarize" "ord_eli5" "ord_explain_code" "ord_commit_message" "ord_summarize_logs" "ord_checklist" "ord_improve_prompt")

# Convert display names array to a newline-separated string for rofi
options=$(printf "%s\n" "${display_names[@]}")

# Show the rofi prompt to the user and get the chosen option
chosen=$(echo "$options" | rofi -dmenu -i -l "${#display_names[@]}" -p "Ord prompt")

# Exit if nothing was chosen
[ "$chosen" != "" ] || exit

# Find the index of the chosen option
for i in "${!display_names[@]}"; do
   if [[ "${display_names[$i]}" == "$chosen" ]]; then
      index=$i
      break
   fi
done

# Extract the command associated with the chosen option using the index
command=${commands[$index]}

# Execute the command
$command
