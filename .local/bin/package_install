#!/bin/bash

# Package installer script for Arch Linux using paru

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_msg() {
	echo -e "${2}${1}${NC}"
}

# Function to check if file exists
check_file() {
	if [[ ! -f "$1" ]]; then
		print_msg "Error: File '$1' not found!" "$RED"
		exit 1
	fi
}

# Function to install packages
install_packages() {
	local file=$1
	local packages=()

	# Read packages from file
	while IFS= read -r package; do
		[[ -n "$package" ]] && packages+=("$package")
	done <"$file"

	if [[ ${#packages[@]} -eq 0 ]]; then
		print_msg "No packages found in $file" "$YELLOW"
		return
	fi

	print_msg "Installing ${#packages[@]} packages from $file..." "$GREEN"

	# Install all packages at once
	paru -S --needed "${packages[@]}"
}

# Display usage
usage() {
	echo "Usage: $0 [OPTIONS]"
	echo "Options:"
	echo "  -o, --official	Install official packages from applist"
	echo "  -a, --aur		Install AUR packages from applist-aur"
	echo "  -b, --both		Install both official and AUR packages"
	echo "  -h, --help		Display this help message"
	exit 0
}

# Main script
if [[ $# -eq 0 ]]; then
	usage
fi

case "$1" in
-a | --aur)
	check_file "$HOME/.config/applist-aur"
	install_packages "$HOME/.config/applist-aur"
	;;
-o | --official)
	check_file "$HOME/.config/applist"
	install_packages "$HOME/.config/applist"
	;;
-b | --both)
	check_file "$HOME/.config/applist"
	check_file "$HOME/.config/applist-aur"
	install_packages "$HOME/.config/applist"
	echo
	install_packages "$HOME/.config/applist-aur"
	;;
-h | --help)
	usage
	;;
*)
	print_msg "Invalid option: $1" "$RED"
	usage
	;;
esac

print_msg "Done!" "$GREEN"
