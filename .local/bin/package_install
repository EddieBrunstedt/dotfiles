#!/usr/bin/env bash

# Package installer for Arch Linux using pacman and paru.
# Idempotency goal: rerunning this script converges the system to the package
# lists without reinstalling up-to-date packages or rebuilding paru unnecessarily.

set -Eeuo pipefail

readonly OFFICIAL_LIST="${XDG_CONFIG_HOME:-$HOME/.config}/applist"
readonly AUR_LIST="${XDG_CONFIG_HOME:-$HOME/.config}/applist-aur"
# Packages built by hand; listed for package_report's benefit, never installed
# here because they exist in no repository.
readonly LOCAL_LIST="${XDG_CONFIG_HOME:-$HOME/.config}/applist-local"

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
	readonly RED=$'\033[0;31m'
	readonly GREEN=$'\033[0;32m'
	readonly YELLOW=$'\033[1;33m'
	readonly NC=$'\033[0m'
else
	readonly RED=''
	readonly GREEN=''
	readonly YELLOW=''
	readonly NC=''
fi

print_msg() {
	printf '%b%s%b\n' "$2" "$1" "$NC"
}

die() {
	print_msg "Error: $*" "$RED" >&2
	exit 1
}

usage() {
	cat <<EOF
Usage: ${0##*/} OPTION

Options:
  -o, --official  Install official packages from applist
  -a, --aur       Install AUR packages from applist-aur
  -b, --both      Install both official and AUR packages
  -h, --help      Display this help message
EOF
}

check_file() {
	[[ -f $1 ]] || die "File '$1' not found"
}

check_prerequisites() {
	((EUID != 0)) || die "Run this script as a regular user, not as root"
	command -v pacman >/dev/null 2>&1 || die "pacman is not installed"
	command -v sudo >/dev/null 2>&1 || die "sudo is not installed"
}

ensure_paru() {
	if command -v paru >/dev/null 2>&1 && paru --version >/dev/null 2>&1; then
		return
	fi

	print_msg "paru is not installed; bootstrapping it from the AUR..." "$GREEN"
	sudo pacman -S --needed base-devel git

	(
		local build_dir
		build_dir=$(mktemp -d)
		trap 'rm -rf -- "$build_dir"' EXIT

		git clone --depth 1 https://aur.archlinux.org/paru.git "$build_dir/paru"
		cd "$build_dir/paru"
		makepkg -si --needed
	)

	if ! command -v paru >/dev/null 2>&1 || ! paru --version >/dev/null 2>&1; then
		die "paru installation did not complete successfully"
	fi
}

read_packages() {
	local file=$1
	local result_name=$2
	local line package
	local -A seen=()
	local -n result=$result_name

	result=()
	while IFS= read -r line || [[ -n $line ]]; do
		# Accept CRLF files, comments, blank lines, and surrounding whitespace.
		line=${line%$'\r'}
		line=${line%%#*}
		package=${line#"${line%%[![:space:]]*}"}
		package=${package%"${package##*[![:space:]]}"}
		[[ -n $package ]] || continue
		[[ $package != -* ]] || die "Invalid package entry '$package' in '$file'"

		if [[ -z ${seen["$package"]+present} ]]; then
			result+=("$package")
			seen["$package"]=1
		fi
	done <"$file"
}

install_official_packages() {
	local -a packages=()
	read_packages "$OFFICIAL_LIST" packages

	if ((${#packages[@]} == 0)); then
		print_msg "No packages found in $OFFICIAL_LIST" "$YELLOW"
		return
	fi

	print_msg "Installing ${#packages[@]} official packages from $OFFICIAL_LIST..." "$GREEN"
	sudo pacman -S --needed -- "${packages[@]}"
}

install_aur_packages() {
	local -a packages=()
	read_packages "$AUR_LIST" packages

	if ((${#packages[@]} == 0)); then
		print_msg "No packages found in $AUR_LIST" "$YELLOW"
		return
	fi

	print_msg "Installing ${#packages[@]} AUR packages from $AUR_LIST..." "$GREEN"
	paru -S --needed -- "${packages[@]}"
}

if (($# != 1)); then
	usage >&2
	exit 2
fi

case $1 in
-h | --help)
	usage
	exit 0
	;;
-o | --official)
	check_file "$OFFICIAL_LIST"
	;;
-a | --aur)
	check_file "$AUR_LIST"
	;;
-b | --both)
	check_file "$OFFICIAL_LIST"
	check_file "$AUR_LIST"
	;;
*)
	print_msg "Invalid option: $1" "$RED" >&2
	usage >&2
	exit 2
	;;
esac

check_prerequisites
ensure_paru

case $1 in
-o | --official)
	install_official_packages
	;;
-a | --aur)
	install_aur_packages
	;;
-b | --both)
	install_official_packages
	printf '\n'
	install_aur_packages
	;;
esac

report_local_packages() {
	local -a packages=()
	[[ -f $LOCAL_LIST ]] || return 0
	read_packages "$LOCAL_LIST" packages
	((${#packages[@]})) || return 0

	printf '\n'
	print_msg "${#packages[@]} local builds are not installed by this script:" "$YELLOW"
	printf '  %s\n' "${packages[@]}"
	print_msg "Build them by hand with makepkg (see $LOCAL_LIST)." "$YELLOW"
}

report_local_packages

printf '\n'
print_msg "Done!" "$GREEN"
