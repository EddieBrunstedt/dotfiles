#!/bin/sh
# Pick one or more directories and open each in its own file-explorer window.
#
#   Enter        take the highlighted directory, then ask for another
#   Ctrl+Enter   take it and open everything now
#   Esc          cancel; nothing opens
#
# Loops rather than using -multi-select so the same directory can be picked twice.

# The only discovery exclusions; ignore files are bypassed.
prune='.git node_modules .cache .npm .npm-global .cargo .rustup .bun
target .venv venv __pycache__ .codex'

sentinel='▶ open the '

notify() { notify-send -u critical "Directory menu" "$1"; }

# Control+Return is freed from kb-accept-custom so kb-custom-1 (exit 10) can take it.
menu() {
    rofi -dmenu -i -sort -mesg "$scan_warning" \
        -matching fuzzy -threads 0 \
        -kb-accept-custom '' \
        -kb-custom-1 'Control+Return' \
        -p "$1"
}

expand_tilde() {
    # shellcheck disable=SC2088  # stripping a literal "~/", not expanding it
    case $1 in
        '~') printf '%s\n' "$HOME" ;;
        '~/'*) printf '%s\n' "$HOME/${1#'~/'}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

set -- --hidden --no-ignore --no-follow --show-errors --absolute-path --color never
for p in $prune; do
    set -- "$@" --exclude "$p"
done

if [ ! -d "$HOME" ]; then
    notify "Home is not a directory: $HOME"
    exit 1
fi
scan_tmp=$(mktemp -d "${TMPDIR:-/tmp}/dir-menu.XXXXXXXXXX") || {
    notify "Could not create discovery workspace"
    exit 1
}
trap 'rm -rf -- "$scan_tmp"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Directories, plus symlinks that point at one (listed, never traversed).
printf '%s\0' "$HOME" > "$scan_tmp/paths"
fd "$@" --type d --print0 '' "$HOME" >> "$scan_tmp/paths" 2>> "$scan_tmp/errors" ||
    printf '%s\n' "Directory scan failed" >> "$scan_tmp/errors"
# shellcheck disable=SC2016 # Variables expand in the batched child shell.
fd "$@" --type l '' "$HOME" -X sh -c '
    for dir do
        if [ -d "$dir" ]; then
            printf "%s\0" "$dir" || exit 1
        fi
    done
' sh >> "$scan_tmp/paths" 2>> "$scan_tmp/errors" ||
    printf '%s\n' "Symlink scan failed" >> "$scan_tmp/errors"

# Rewrite as ~/... rows. Paths containing newlines can't be menu rows; skip them.
DIR_MENU_SKIPPED="$scan_tmp/skipped" LC_ALL=C awk '
    BEGIN {
        RS = "\0"
        home = ENVIRON["HOME"]
        if (home != "/") sub(/\/+$/, "", home)
    }
    {
        if (index($0, "\n")) {
            print "Skipped newline-containing path" > ENVIRON["DIR_MENU_SKIPPED"]
            next
        }
        if ($0 != "/") sub(/\/+$/, "")
        if ($0 == home) print "~"
        else if (home == "/") print "~" $0
        else if (index($0, home "/") == 1)
            print "~" substr($0, length(home) + 1)
    }
' "$scan_tmp/paths" > "$scan_tmp/rows" || {
    notify "Could not prepare directory list"
    exit 1
}
# Bytewise sort puts ~ itself first.
candidates=$(LC_ALL=C sort -u "$scan_tmp/rows") || {
    notify "Could not sort directory list"
    exit 1
}
scan_warning=
if [ -s "$scan_tmp/errors" ]; then
    scan_warning="Discovery incomplete: some directories could not be scanned."
fi
if [ -s "$scan_tmp/skipped" ]; then
    scan_warning="${scan_warning:+$scan_warning }Paths containing newlines were omitted."
fi
[ -z "$scan_warning" ] || notify "$scan_warning"
rm -rf -- "$scan_tmp"
trap - 0 HUP INT TERM

if [ -z "$candidates" ]; then
    notify "No directories found"
    exit 1
fi

# "$@" now collects the picked directories.
set --

while :; do
    prompt="Directory $(($# + 1))"
    list=$candidates
    if [ $# -gt 0 ]; then
        prompt="$prompt  (Ctrl+Enter opens now, Esc cancels)"
        list="$sentinel$# selected
$candidates"
    fi

    chosen=$(printf '%s\n' "$list" | menu "$prompt")
    status=$?

    # Anything but Enter (0) or Ctrl+Enter (10) cancels the whole selection.
    case $status in
        0 | 10) ;;
        *) exit 0 ;;
    esac

    if [ -z "$chosen" ]; then
        [ "$status" -eq 10 ] && break
        continue
    fi

    case $chosen in
        "$sentinel"*) break ;;
    esac

    dir=$(expand_tilde "$chosen")
    if [ ! -d "$dir" ]; then
        notify "Not a directory: $dir"
        continue
    fi

    set -- "$@" "$dir"
    [ "$status" -eq 10 ] && break
done

[ $# -gt 0 ] || exit 0

# Opens via the inode/directory handler (file.desktop). gio, not xdg-open,
# which blocks until the terminal exits. Sequential to keep the tiling order.
for dir do
    gio open "$dir" || notify "Could not open $dir"
done
