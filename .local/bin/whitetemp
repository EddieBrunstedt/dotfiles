#!/bin/sh
# Pick a screen white point in rofi; gammastep holds it as a transient unit.
# 6500 K means no unit running.

list='6500|Reset to default (6500 K)
4500|4500 K
4000|4000 K
3500|3500 K
3000|3000 K
2500|2500 K'

cur=6500
if systemctl --user is-active --quiet whitetemp.service; then
    active=$(systemctl --user show whitetemp.service -p ExecStart --value 2>/dev/null \
             | grep -oE '\-O[[:space:]]*[0-9]+' | grep -oE '[0-9]+')
    [ -n "$active" ] && cur=$active
fi

rows=$(printf '%s\n' "$list" \
    | awk -F'[|]' -v cur="$cur" '{printf "%s%s\n", $2, ($1 == cur ? " ●" : "")}')

chosen=$(printf '%s\n' "$rows" | rofi -dmenu -i -no-custom \
    -l "$(printf '%s\n' "$rows" | wc -l)" -p "White point") || exit 0
[ -n "$chosen" ] || exit 0

label=${chosen% ●}
temp=$(printf '%s\n' "$list" | awk -F'[|]' -v lbl="$label" '$2 == lbl { print $1; exit }')
[ -n "$temp" ] || exit 1

systemctl --user stop whitetemp.service 2>/dev/null

# Not named gammastep: the package ships a gammastep.service of its own.
if [ "$temp" != 6500 ]; then
    systemd-run --user --quiet --collect \
        --unit=whitetemp \
        --slice=app-graphical.slice \
        gammastep -P -O "$temp"
fi

pkill -RTMIN+5 waybar
