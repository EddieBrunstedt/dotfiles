#!/bin/sh
#Set white temperature with gammastep and rofi (Wayland)

list='6500 K (default day)
4500 K (default night)
4000 K
3500 K
3000 K
2500 K'

chosen=$(printf '%s\n' "$list" | rofi -dmenu -i -l 6 -p "White temp")

[ "$chosen" != "" ] || exit

center=${chosen%% *}

# On Wayland the gamma resets when the client exits, so gammastep must keep
# running to hold the temperature. Replace any running instance and detach.
pkill -x gammastep
setsid -f gammastep -P -O "$center" >/dev/null 2>&1
