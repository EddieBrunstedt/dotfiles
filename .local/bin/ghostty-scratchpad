#!/bin/sh
# Single-flight launcher for the Super+z dropdown scratchpad terminal.
#
# mango's toggle_named_scratchpad runs this ONLY when no scratchpad window
# exists (i.e. the terminal is truly closed) -- when one exists it just
# shows/hides it without calling us. Our only job is to swallow a fast
# double-press during ghostty's startup gap, when two presses both see
# "no window yet" and would each spawn a terminal.
#
# We hold an flock just long enough to bridge that gap, then release it.
# Crucially ghostty is launched with the lock fd CLOSED (9>&-), so the lock
# is never tied to the terminal's lifetime. A closed or force-killed terminal
# therefore always leaves the lock free and can be relaunched.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/ghostty-scratchpad.lock"
exec 9>"$LOCK"
flock -n 9 || exit 0            # another launch is mid-startup -> do nothing
ghostty --class=com.ghostty.scratchpad 9>&- &
sleep 1.5                       # keep lock ~1.5s to cover the startup gap
