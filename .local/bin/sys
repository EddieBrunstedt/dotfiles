#!/usr/bin/env bash

case "$(printf "kill\nsuspend\nreboot\nshutdown" | dmenu -i -l 4)" in
	kill)
		ps -u $USER -o pid,comm,%cpu,%mem | dmenu -i -l 10 -p Kill: | awk '{print $1}' | xargs -r kill
		;;
	suspend)
		gpgconf --reload gpg-agent
		gpg-connect-agent 'clear_passphrase' /bye
		betterlockscreen -l &
		sleep 1 && systemctl suspend -i
		;;
	reboot)
		systemctl reboot -i
		;;
	shutdown)
		shutdown now
		;;
	*)
		exit 1
		;;
esac
