#!/usr/bin/env python3
"""Minimal org.freedesktop.FileManager1 service.

Opens folders, and reveals files, with the inode/directory handler from
mimeapps.list (file.desktop). Given a file, yazi opens its folder with the file
hovered.
"""

import os
import shlex
import subprocess
import sys
import urllib.parse

import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import Gio, GLib

BUS_NAME = "org.freedesktop.FileManager1"
OBJECT_PATH = "/org/freedesktop/FileManager1"
INTERFACE = "org.freedesktop.FileManager1"
IDLE_TIMEOUT_SECONDS = 300


def uri_to_path(uri):
    if not uri:
        return os.path.expanduser("~")

    uri = str(uri)
    parsed = urllib.parse.urlparse(uri)

    if parsed.scheme == "file":
        return urllib.parse.unquote(parsed.path) or os.path.expanduser("~")

    if parsed.scheme == "":
        return os.path.expanduser(uri)

    return os.path.expanduser("~")


def show(uris):
    path = uri_to_path(uris[0] if uris else "")

    if path.startswith("~"):
        path = os.path.expanduser(path)

    # For testing: FILEMANAGER1_OPEN_COMMAND=/bin/true filemanager-yazi
    override = os.environ.get("FILEMANAGER1_OPEN_COMMAND")
    if override:
        subprocess.Popen(
            shlex.split(override) + [path],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return

    # The directory handler even for a file: `gio open` would pick the handler
    # by the file's own type and open it (a PDF in zathura) instead of revealing it.
    # file.desktop's Exec uses `uwsm app`, so windows outlive this service.
    app = Gio.AppInfo.get_default_for_type("inode/directory", False)
    if app is None:
        print("No inode/directory handler in mimeapps.list", file=sys.stderr)
        return
    try:
        app.launch([Gio.File.new_for_path(path)], None)
    except GLib.Error as exc:
        print(f"Could not open {path}: {exc.message}", file=sys.stderr)


class FileManager1(dbus.service.Object):
    def __init__(self, bus, loop):
        super().__init__(bus, OBJECT_PATH)
        self.loop = loop
        self._idle_source = None
        self._reset_idle_timer()

    def _reset_idle_timer(self):
        if self._idle_source is not None:
            GLib.source_remove(self._idle_source)
        self._idle_source = GLib.timeout_add_seconds(IDLE_TIMEOUT_SECONDS, self._quit_if_idle)

    def _quit_if_idle(self):
        self.loop.quit()
        return False

    def _handle(self, uris):
        self._reset_idle_timer()
        show(list(uris))

    @dbus.service.method(INTERFACE, in_signature="ass", out_signature="")
    def ShowFolders(self, uris, startup_id):
        self._handle(uris)

    @dbus.service.method(INTERFACE, in_signature="ass", out_signature="")
    def ShowItems(self, uris, startup_id):
        self._handle(uris)

    @dbus.service.method(INTERFACE, in_signature="ass", out_signature="")
    def ShowItemProperties(self, uris, startup_id):
        self._handle(uris)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    loop = GLib.MainLoop()
    bus = dbus.SessionBus()

    try:
        name = dbus.service.BusName(BUS_NAME, bus, do_not_queue=True)
    except dbus.DBusException as exc:
        print(f"Could not own {BUS_NAME}: {exc}", file=sys.stderr)
        return 1

    service = FileManager1(bus, loop)
    loop.run()
    # Keep references alive until after the main loop exits.
    _ = (name, service)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
