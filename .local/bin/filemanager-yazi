#!/usr/bin/env python3
"""Minimal org.freedesktop.FileManager1 service that opens the default file manager.

The handler itself is not chosen here: it comes from inode/directory in
mimeapps.list, which points at file.desktop. That entry is the single place the
file explorer is defined, shared with dir-menu and every GUI app.
"""

import os
import shlex
import subprocess
import sys
import urllib.parse

import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

BUS_NAME = "org.freedesktop.FileManager1"
OBJECT_PATH = "/org/freedesktop/FileManager1"
INTERFACE = "org.freedesktop.FileManager1"
IDLE_TIMEOUT_SECONDS = 300


def uri_to_path(uri):
    if not uri:
        return os.path.expanduser("~")

    uri = str(uri)
    parsed = urllib.parse.urlparse(uri)

    if parsed.scheme == "file":
        # FileManager1 callers normally pass file:// URIs.
        return urllib.parse.unquote(parsed.path) or os.path.expanduser("~")

    if parsed.scheme == "":
        return os.path.expanduser(uri)

    # The handler is a local file manager, so non-file schemes are not useful here.
    return os.path.expanduser("~")


def open_directory(uris):
    path = uri_to_path(uris[0] if uris else "")

    if path.startswith("~"):
        path = os.path.expanduser(path)

    # Allow a harmless command override for testing, e.g.
    # FILEMANAGER1_OPEN_COMMAND=/bin/true filemanager-yazi
    override = os.environ.get("FILEMANAGER1_OPEN_COMMAND")
    if override:
        command = shlex.split(override) + [path]
    else:
        # `gio open` rather than a hardcoded terminal command, so the explorer is
        # defined in exactly one place (file.desktop) instead of here as well.
        #
        # It resolves inode/directory through mimeapps.list and runs that entry's
        # Exec, which already starts with `uwsm app --`. The terminal therefore
        # still ends up in app-graphical.slice as its own unit rather than in this
        # service's cgroup -- which matters, because this service exits when idle
        # and would otherwise take the open windows down with it.
        #
        # Not `xdg-open`: with no recognised desktop environment it falls back to
        # a generic path that runs the Exec line in the foreground, so the call
        # would not return until the file manager was closed.
        command = ["gio", "open", path]

    subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


class FileManager1(dbus.service.Object):
    def __init__(self, bus, loop):
        super().__init__(bus, OBJECT_PATH)
        self.loop = loop
        self._idle_source = None
        self._reset_idle_timer()

    def _reset_idle_timer(self):
        if self._idle_source is not None:
            GLib.source_remove(self._idle_source)
        self._idle_source = GLib.timeout_add_seconds(IDLE_TIMEOUT_SECONDS, self._quit_if_idle)

    def _quit_if_idle(self):
        self.loop.quit()
        return False

    def _handle(self, uris):
        self._reset_idle_timer()
        open_directory(list(uris))

    @dbus.service.method(INTERFACE, in_signature="ass", out_signature="")
    def ShowFolders(self, uris, startup_id):
        self._handle(uris)

    @dbus.service.method(INTERFACE, in_signature="ass", out_signature="")
    def ShowItems(self, uris, startup_id):
        self._handle(uris)

    @dbus.service.method(INTERFACE, in_signature="ass", out_signature="")
    def ShowItemProperties(self, uris, startup_id):
        self._handle(uris)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    loop = GLib.MainLoop()
    bus = dbus.SessionBus()

    try:
        name = dbus.service.BusName(BUS_NAME, bus, do_not_queue=True)
    except dbus.DBusException as exc:
        print(f"Could not own {BUS_NAME}: {exc}", file=sys.stderr)
        return 1

    service = FileManager1(bus, loop)
    loop.run()
    # Keep references alive until after the main loop exits.
    _ = (name, service)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
