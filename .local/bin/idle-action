#!/usr/bin/env bash
# idle-action — what happens when the session goes idle, run by swayidle.service.
#
# Two things, in this order: lock, then power the panel down. Ordering is the
# whole reason this is a script rather than a shell fragment in the unit —
# blanking first would leave a dark screen over a still-unlocked desktop, which
# the very next mouse jiggle would put straight back on display.
#
# Locking policy itself lives in lock-screen (keyboard layout, do-not-disturb),
# so a keybind lock and an idle lock stay identical. Nothing here suspends: the
# machine keeps serving Jellyfin with the monitor off.
set -u

warn() { printf 'idle-action: %s\n' "$1" >&2; }

# Locked by hand already (SUPER+q, then walked away)? Then there is nothing to
# establish and nothing to wait for: a second swaylock would only refuse, and
# the readiness wait below would sit out its full timeout for a signal that can
# never arrive.
if pgrep -x swaylock >/dev/null; then
  exec wlopm --off '*'
fi

# swaylock's --ready-fd is its "the session lock is now established" signal: one
# write, then close. Wait for it rather than sleeping a guessed interval.
#
# The fifo is opened read-write here, so the read below can never block in
# open() waiting for a writer that failed to appear — the timeout bounds the
# rest. XDG_RUNTIME_DIR is the right home for it: 0700, and cleared at logout.
ready=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/idle-action.XXXXXX")
if mkfifo -m 600 "$ready" 2>/dev/null && exec 3<>"$ready"; then
  rm -f "$ready"   # unlinked immediately; the open descriptors keep it alive
  "$HOME"/.local/bin/lock-screen --ready-fd 4 4>&3 &
  # Returns as soon as swaylock reports the lock, and after 5s regardless.
  # Status is deliberately ignored: this fd is held open for writing here too,
  # so a dying swaylock produces a timeout rather than an EOF. Whether the lock
  # actually took is settled by pgrep below, not by this read.
  read -r -t 5 -u 3 _ || :
  exec 3>&-
else
  warn "could not create the readiness fifo — locking without waiting for it"
  "$HOME"/.local/bin/lock-screen &
  sleep 1
fi

# Blank either way. A lock that failed to take is a problem to report, but
# refusing to blank would not fix it: the session would be exactly as unlocked
# with the panel left burning. The message goes to the journal
# (journalctl --user -u swayidle) because lock-screen has just paused dunst.
pgrep -x swaylock >/dev/null || warn "no swaylock running — blanking an UNLOCKED session"

# wlr-output-power-management, not wlr-randr: mango flags a monitor powered off
# this way as only_sleep and keeps it in the output layout (updatemons() in
# mango.c), so windows are not reflowed onto a phantom smaller desktop and the
# mode survives. Disabling the output outright does not take that path.
exec wlopm --off '*'
