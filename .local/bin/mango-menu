#!/bin/sh
# mango-menu — rofi menu of occasional Mango / session actions, bound to
# SUPER+SHIFT+m. Frequent actions stay on their own keys; this collects the
# ones nicer to pick from a list than to memorize.

menu() { rofi -dmenu -i -p "$1"; }
confirm() { [ "$(printf '%s\n' 'No' 'Yes' | menu "$1")" = "Yes" ]; }

# Change only this value if the dictation backend is replaced.
dictation_service=voxtype

# map a mango layout symbol to its full name (IPC only exposes the symbol;
# table from src/layout/layout.h in the mango source)
layout_name() {
  case "$1" in
    T) echo tile ;; S) echo scroller ;; G) echo grid ;; M) echo monocle ;;
    K) echo deck ;; CT) echo center_tile ;; RT) echo right_tile ;;
    VS) echo vertical_scroller ;; VT) echo vertical_tile ;;
    VG) echo vertical_grid ;; VK) echo vertical_deck ;;
    DW) echo dwindle ;; F) echo fair ;; VF) echo vertical_fair ;;
    *) echo "$1" ;;
  esac
}

main=$(printf '%s\n' \
  "At a glance" \
  "Audio output…" \
  "Keyboard layout…" \
  "Power…" \
  "Reload config" \
  "Restart Waybar" \
  "Set layout…" \
  "Toggle Do Not Disturb" \
  "Dictation…" \
  "White temperature…")

chosen=$(printf '%s' "$main" | menu "Mango")
[ -n "$chosen" ] || exit 0

case "$chosen" in
  "At a glance")
    # Session dashboard (safe top-of-list entry: absorbs accidental Enter).
    # Status lines are inert; selecting a window row jumps to its tag, so it
    # doubles as a searchable window switcher.
    vpn=$(mullvad status 2>/dev/null | head -n1); [ -n "$vpn" ] || vpn="?"
    sink=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null \
           | sed -n 's/.*node\.description = "\(.*\)"/\1/p'); [ -n "$sink" ] || sink="?"
    [ "$(dunstctl is-paused 2>/dev/null)" = "true" ] && dnd="paused" || dnd="on"
    kb=$(mmsg get keyboardlayout 2>/dev/null | jq -r '.layout // "?"')
    mon=$(mmsg get focusing-client 2>/dev/null | jq -r '.monitor // "DP-1"')
    layout=$(mmsg get tags "$mon" 2>/dev/null \
             | jq -r '.tags[] | select(.is_active) | .layout' \
             | while IFS= read -r s; do layout_name "$s"; done | paste -sd+ -)
    windows=$(mmsg get all-clients 2>/dev/null | jq -r \
      '.clients | map(select(.tags|length>0)) | sort_by(.tags[0])[]
       | "[\(.tags[0])] \(.appid) — \(.title)"')
    pick=$(printf '%s\n%s\n%s\n%s\n%s\n%s\n%s' \
      "VPN: $vpn" \
      "Audio: $sink" \
      "Notifications: $dnd" \
      "Layout: $layout" \
      "Keyboard: $kb" \
      "──────────" \
      "$windows" | menu "At a glance")
    # window rows start with "[N]" — jump to that tag; anything else is inert
    tag=$(printf '%s' "$pick" | sed -n 's/^\[\([1-9]\)\].*/\1/p')
    [ -n "$tag" ] && mmsg dispatch view,"$tag",0 >/dev/null ;;

  "Audio output…")
    # Pick the default audio sink (current one marked with ●)
    sinks=$(wpctl status | sed -n '/Audio/,/Video/p' | sed -n '/Sinks:/,/Sources:/p')
    cur=$(printf '%s\n' "$sinks" | sed -n 's/^[^0-9*]*\*\s*\([0-9]\+\)\..*/\1/p')
    rows=$(printf '%s\n' "$sinks" \
      | sed -n 's/^[^0-9]*\([0-9]\+\)\.\s*\(.*\S\)\s*\[vol.*/\1. \2/p' \
      | while IFS= read -r r; do
          [ "${r%%.*}" = "$cur" ] && printf '%s ●\n' "$r" || printf '%s\n' "$r"
        done)
    pick=$(printf '%s\n' "$rows" | menu "Audio output")
    [ -n "$pick" ] || exit 0
    id=${pick%%.*}
    if wpctl set-default "$id"; then
      notify-send "Audio output" "Default sink: ${pick#*. }"
    fi ;;

  "Set layout…")
    layout=$(printf '%s\n' \
      center_tile deck fair right_tile tile vertical_fair vertical_tile \
      | menu "Layout")
    [ -n "$layout" ] && mmsg dispatch setlayout,"$layout" >/dev/null ;;

  "Reload config")
    mmsg dispatch reload_config >/dev/null ;;

  "Restart Waybar")
    # Must go through systemd: waybar.service has Restart=on-failure, so pkill
    # alone would trigger a restart and a bare respawn would leave two instances.
    systemctl --user restart waybar ;;

  "White temperature…")
    "$HOME/.local/bin/whitetemp" ;;

  "Keyboard layout…")
    "$HOME/.local/bin/keyboard-layout-menu" ;;

  "Toggle Do Not Disturb")
    "$HOME/.local/bin/dunst-toggle" ;;

  "Dictation…")
    # Labels name the systemctl verb they run, not the capability it grants.
    action=$(printf '%s\n' "Start service" "Stop service" | menu "Dictation")
    case "$action" in
      "Start service")
        if systemctl --user start "$dictation_service"; then
          notify-send "Dictation" "$dictation_service started — hold Super+V to dictate"
        else
          notify-send -u critical "Dictation" "Could not start $dictation_service"
        fi ;;
      "Stop service")
        if systemctl --user stop "$dictation_service"; then
          notify-send "Dictation" "$dictation_service stopped"
        else
          notify-send -u critical "Dictation" "Could not stop $dictation_service"
        fi ;;
    esac ;;

  "Power…")
    # Each entry runs exactly the one command its label names; none of them
    # chain a session stop into a power action.
    action=$(printf '%s\n' "Power off" "Reboot" "Stop Mango session" "Suspend" \
             | menu "Power")
    case "$action" in
      "Suspend")   systemctl suspend ;;
      "Reboot")    confirm "Reboot?"    && systemctl reboot ;;
      "Power off") confirm "Power off?" && systemctl poweroff ;;
      # uwsm stop walks wayland-session@mango.desktop.target down in dependency
      # order; killing the compositor directly does not.
      "Stop Mango session")
        confirm "Stop Mango session?" && uwsm stop ;;
    esac ;;
esac
