#!/usr/bin/env bash
# Rofi menu of open Claude Code sessions (waiting, working, idle; newest first).
# Picking one focuses its Ghostty window, or attaches a background session.

set -u

# Unit separator, not tab: read would collapse empty tab-separated fields.
US=$'\x1f'

records=
for file in ~/.claude/sessions/*.json; do
    IFS=$US read -r pid start status kind updated id cwd name job < <(jq -r \
        '[.pid, .procStart, .status // "starting", .kind, .statusUpdatedAt // 0,
          .sessionId, .cwd, .name // "", .jobId // ""] | join("\u001f")' \
        "$file" 2>/dev/null) || continue
    [ "$kind" = daemon ] && continue
    # Skip files left behind by dead sessions.
    [ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)" = "$start" ] || continue
    case $status in
        waiting) rank=0 icon=󰏤 ;;
        busy | shell) rank=1 icon=󰚩 ;;
        *) rank=2 icon=󰒲 ;;
    esac

    transcript=~/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$cwd")/$id.jsonl
    title=$(grep -hoE '"(customTitle|aiTitle)":"[^"]*"' "$transcript" 2>/dev/null | tail -1 | cut -d'"' -f4)
    label=${title:-$name}
    dir=${cwd/#$HOME/\~}

    records+="$rank $((9999999999999 - updated))$US$icon$US$label$US$dir$US$kind$US$job$US$id$US${title:-Claude Code}"$'\n'
done
[ -n "$records" ] || exit 0
records=$(printf %s "$records" | sort -t "$US" -k1,1)

rows=$(awk -F "$US" '
    { icon[NR] = $2; label[NR] = length($3) > 45 ? substr($3, 1, 44) "…" : $3
      dir[NR] = $4; if (length(label[NR]) > w) w = length(label[NR]) }
    END { for (i = 1; i <= NR; i++) printf "%s  %-*s  %s\n", icon[i], w, label[i], dir[i] }
' <<<"$records")

count=$(wc -l <<<"$records")
pick=$(rofi -dmenu -i -no-custom -format i -p Claude -l "$((count < 10 ? count : 10))" <<<"$rows") || exit 0
[ -n "$pick" ] || exit 0

IFS=$US read -r _ _ _ _ kind job id title < <(sed -n "$((pick + 1))p" <<<"$records")

clients=$(mmsg get all-clients 2>/dev/null)

if [ "$kind" = bg ]; then
    # Reuse a window opened here before, found by pid.
    attach="ghostty -e claude attach ${job:-$id}"
    window=$(jq -r --argjson pids "[$(pgrep -d, -fx "$attach")]" '
      [.clients[] | select(.pid as $p | $pids | index($p))][0] // empty | .id' \
      <<<"$clients" 2>/dev/null)
    [ -n "$window" ] || exec $attach
    exec mmsg dispatch focusid client,"$window" >/dev/null
fi

# Ghostty's window title is the session title, possibly behind a spinner glyph.
window=$(jq -r --arg t "$title" '
  [.clients[] | select(.appid == "com.mitchellh.ghostty")
              | select(.title == $t or (.title | sub("^[^ ]+ "; "")) == $t)][0]
  // empty | .id' <<<"$clients" 2>/dev/null)
[ -n "$window" ] && mmsg dispatch focusid client,"$window" >/dev/null
