#!/bin/sh
# Load ~/.secrets/env consistently for POSIX shells, fish, and nushell.
#
# File format: shell/systemd-compatible KEY=value lines. Blank lines and lines
# starting with # are ignored. Quote values with single or double quotes when
# they contain spaces or shell-significant characters. Prefer plain KEY=value
# over `export KEY=value` so the same file also works with systemd EnvironmentFile.

set -eu

mode=nul
case "${1-}" in
    --sh)
        mode=sh
        shift
        ;;
esac

file=${1:-"$HOME/.secrets/env"}
[ -f "$file" ] || exit 0

keys=$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' "$file" | sort -u)
[ -n "$keys" ] || exit 0

set -a
# shellcheck disable=SC1090
. "$file"
set +a

quote_sh() {
    # Single-quote for POSIX shell eval/export output.
    printf "%s" "$1" | sed "s/'/'\\\\''/g; 1s/^/'/; \$s/\$/'/"
}

for key in $keys; do
    eval "is_set=\${$key+x}"
    [ "$is_set" = x ] || continue
    eval "value=\${$key}"

    case "$mode" in
        sh)
            printf 'export %s=' "$key"
            quote_sh "$value"
            printf '\n'
            ;;
        nul)
            printf '%s=%s\0' "$key" "$value"
            ;;
    esac
done
