# Which tool may see which secret. Read by ~/.local/libexec/shim.
#
# Each entry needs a matching symlink in this directory:
#     ln -s ../../libexec/shim <tool>
#
# Columns: tool, real binary (absolute, or ~/ for $HOME), secret names.
# A tool receives exactly the secrets listed here and nothing else.

claude              /usr/bin/claude                  ANTHROPIC_API_KEY
codex               /usr/bin/codex                   OPENAI_API_KEY
opencode            /usr/bin/opencode                OPENROUTER_API_KEY
ord                 /usr/bin/ord                     OPENROUTER_API_KEY
protonmail-status   ~/.cargo/bin/protonmail-status   PROTON_BRIDGE_IMAP_USER PROTON_BRIDGE_IMAP_PASS
telltale-inbox      ~/.cargo/bin/telltale-inbox      PROTON_BRIDGE_IMAP_USER PROTON_BRIDGE_IMAP_PASS
