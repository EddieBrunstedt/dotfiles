#!/bin/sh
# power-menu — rofi menu of session and power actions, bound to SUPER+q.
#
# Flat on purpose: rofi filters rather than navigates, so a submenu would only
# ever cost a keypress. Rows are alphabetical, which happens to leave the
# harmless "Lock and blank screen" under the cursor; everything that cannot be
# undone asks first. Each entry runs exactly the one command its label names —
# none of them chain a session stop into a power action.

menu() { rofi -dmenu -i -no-custom -l "$1" -p "$2"; }
confirm() { [ "$(printf '%s\n' 'No' 'Yes' | menu 2 "$1")" = "Yes" ]; }

action=$(printf '%s\n' \
  "Lock and blank screen" \
  "Lock screen" \
  "Power off" \
  "Reboot" \
  "Reboot to Windows" \
  "Stop Mango session" \
  "Suspend" \
  | menu 7 "Power") || exit 0
[ -n "$action" ] || exit 0

case "$action" in
  # Wrapper, not swaylock directly: it switches the keyboard to US first.
  "Lock screen") exec "$HOME/.local/bin/lock-screen" ;;

  # Same lock, plus the panel put to sleep immediately rather than after
  # swayidle.service's ten idle minutes. Not a bare wlopm call: lock-blank also
  # leaves behind the one-shot listener that wakes the panel on the next
  # keypress, which swayidle.service cannot do until its own timeout has fired.
  "Lock and blank screen") exec "$HOME/.local/bin/lock-blank" ;;
  "Suspend")     systemctl suspend ;;
  "Reboot")      confirm "Reboot?"    && systemctl reboot ;;
  "Power off")   confirm "Power off?" && systemctl poweroff ;;

  # grub-reboot only sets next_entry in grubenv; GRUB consumes and clears it
  # while booting, so this is one shot and the default stays Arch. The argument
  # must match the menuentry title in grub.cfg verbatim. Reboot only on success,
  # otherwise walking away would land you back in Arch.
  "Reboot to Windows")
    confirm "Reboot to Windows?" || exit 0
    if sudo grub-reboot Windows; then
      systemctl reboot
    else
      notify-send -u critical "Reboot to Windows" \
        "Could not set the GRUB one-shot entry — rebooting was skipped"
    fi ;;

  # uwsm stop walks wayland-session@mango.desktop.target down in dependency
  # order; killing the compositor directly does not.
  "Stop Mango session")
    confirm "Stop Mango session?" && uwsm stop ;;
esac
