#!/bin/sh
# Rofi menu of session and power actions. Anything irreversible asks first.

menu() { rofi -dmenu -i -no-custom -l "$1" -p "$2"; }
confirm() { [ "$(printf '%s\n' 'No' 'Yes' | menu 2 "$1")" = "Yes" ]; }

action=$(printf '%s\n' \
  "Lock and blank screen" \
  "Lock screen" \
  "Power off" \
  "Reboot" \
  "Reboot to Windows" \
  "Stop Mango session" \
  | menu 6 "Power") || exit 0
[ -n "$action" ] || exit 0

case "$action" in
  "Lock screen") exec "$HOME/.local/bin/lock-screen" ;;
  "Lock and blank screen") exec "$HOME/.local/bin/lock-blank" ;;
  "Reboot")      confirm "Reboot?"    && systemctl reboot ;;
  "Power off")   confirm "Power off?" && systemctl poweroff ;;

  # One-shot boot entry; must match the grub.cfg menuentry title exactly.
  "Reboot to Windows")
    confirm "Reboot to Windows?" || exit 0
    if sudo grub-reboot Windows; then
      systemctl reboot
    else
      notify-send -u critical "Reboot to Windows" \
        "Could not set the GRUB one-shot entry — rebooting was skipped"
    fi ;;

  "Stop Mango session")
    confirm "Stop Mango session?" && uwsm stop ;;
esac
