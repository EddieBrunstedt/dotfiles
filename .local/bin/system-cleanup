#!/bin/sh
# Reclaim disk space: package and build caches, build artifacts, devtools
# chroots and unused Docker data. Everything removed can be rebuilt or
# re-downloaded; named Docker volumes are never touched.
#
# No -e: steps are independent and a failing one must not stop the rest.
set -u

usage() {
    printf 'Usage: system-cleanup\n'
    printf 'Clean caches, build artifacts and unused Docker data; retain one package version.\n'
    printf 'Named Docker volumes are never removed.\n'
}

case "${1-}" in
    '') ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

failed=0
failures=
run_step() {
    label=$1
    shift
    printf '\n== %s ==\n' "$label"
    if "$@"; then
        printf 'OK: %s\n' "$label"
    else
        status=$?
        printf 'FAILED: %s (exit %s)\n' "$label" "$status" >&2
        failures="${failures}
  - $label (exit $status)"
        failed=$((failed + 1))
    fi
}

# Native-label CI jobs run in the runner's cgroup, so more than one process = busy.
runner_busy() {
    cgroup=$(systemctl --user show -p ControlGroup --value forgejo-runner.service 2>/dev/null) ||
        return 1
    procs=/sys/fs/cgroup$cgroup/cgroup.procs
    [ -n "$cgroup" ] && [ -r "$procs" ] || return 1
    [ "$(wc -l < "$procs")" -gt 1 ]
}

# Doorman CI's CARGO_TARGET_DIR; nothing else ever trims it.
clear_doorman_ci_cache() {
    target=$HOME/.cache/doorman-ci/target
    if [ ! -e "$target" ]; then
        printf 'Nothing to remove.\n'
        return 0
    fi
    if runner_busy; then
        printf 'A Forgejo CI job is running; rerun once it finishes.\n' >&2
        return 1
    fi
    rm -rf -- "$target"
}

# pkgctl build chroots; the next build recreates them.
clear_archbuild() {
    dir=/var/lib/archbuild
    if [ ! -e "$dir" ]; then
        printf 'Nothing to remove.\n'
        return 0
    fi
    if pgrep -x makechrootpkg >/dev/null || pgrep -x arch-nspawn >/dev/null; then
        printf 'A devtools package build is running; rerun once it finishes.\n' >&2
        return 1
    fi
    sudo rm -rf --one-file-system -- "$dir"
}

available_kb() {
    df -Pk / "$HOME" /var/cache/pacman/pkg /var/lib/docker /var/log 2>/dev/null |
        awk 'NR > 1 && !seen[$1]++ { total += $4 } END { printf "%.0f\n", total }'
}

human_kb() {
    if command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec-i --suffix=B "$(( $1 * 1024 ))"
    else
        awk -v kib="$1" 'BEGIN {
            split("KiB MiB GiB TiB", units)
            value = kib
            unit = 1
            while (value >= 1024 && unit < 4) {
                value /= 1024
                unit++
            }
            printf "%.1f %s\n", value, units[unit]
        }'
    fi
}

before_kb=$(available_kb)
printf 'Available disk space before cleanup: %s\n\n' "$(human_kb "$before_kb")"

run_step 'Pacman archives (keep one version)' sudo paccache --remove --keep 1
run_step 'Pacman archives of uninstalled packages' sudo paccache --remove --uninstalled --keep 0
run_step 'devtools build chroots' clear_archbuild
# Can race a CI job that has pulled an image but not started its container yet.
run_step 'Stopped containers and unused Docker images, networks and build cache' \
    docker system prune --all --force
# After the container prune. Without --all, named volumes are kept.
run_step 'Unused anonymous Docker volumes' docker volume prune --force
run_step 'Unreferenced pnpm store packages' pnpm store prune
run_step 'npm cache verification and garbage collection' npm cache verify
run_step 'Go build and test caches' go clean -cache -testcache
run_step 'tldr cache' tldr --clear-cache
# kondo skips hidden directories (~/.cargo, ~/.local/share).
run_step 'Project build artifacts (kondo)' kondo --all "$HOME"
run_step 'Doorman CI build cache' clear_doorman_ci_cache

after_kb=$(available_kb)
difference_kb=$((after_kb - before_kb))

printf '\nAvailable disk space after cleanup:  %s\n' "$(human_kb "$after_kb")"
if [ "$difference_kb" -gt 0 ]; then
    printf 'Disk space reclaimed:              %s\n' "$(human_kb "$difference_kb")"
elif [ "$difference_kb" -lt 0 ]; then
    printf 'Available disk space decreased by: %s\n' "$(human_kb "$((-difference_kb))")"
else
    printf 'No net change in available disk space.\n'
fi

if [ "$failed" -ne 0 ]; then
    printf '\nCleanup incomplete: %s step(s) failed:%s\n' "$failed" "$failures" >&2
    exit 1
fi
printf '\nCleanup completed: all requested steps succeeded.\n'
