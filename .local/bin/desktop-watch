#!/bin/sh
# Signal waybar's custom/desktop segment whenever ~/desktop changes.
# Run by desktop-watch.service.
set -u

dir="$HOME/desktop"
fifo="${XDG_RUNTIME_DIR:-/tmp}/desktop-watch.fifo"

# Only signal a waybar that already handles RTMIN+6 (signal 40, bit 39 of
# SigCgt); before its handler is installed the signal kills it.
refresh() {
    for pid in $(pgrep -x waybar); do
        mask=$(sed -n 's/^SigCgt:[[:space:]]*//p' "/proc/$pid/status" 2>/dev/null)
        [ -n "$mask" ] || continue
        [ $((0x${mask#??????} >> 39 & 1)) -eq 1 ] || continue
        kill -s RTMIN+6 "$pid" 2>/dev/null
    done
    return 0
}

rm -f "$fifo"
mkfifo "$fifo" || exit 1
cleanup() {
    [ -n "${watcher:-}" ] && kill "$watcher" 2>/dev/null
    rm -f "$fifo"
}
trap cleanup EXIT
# Must exit, or SIGTERM just resumes the loop.
trap 'exit 0' INT TERM

while :; do
    # Re-arm on a fresh inode if ~/desktop was deleted.
    mkdir -p "$dir"
    refresh

    # Backgrounded so it can be killed: after DELETE_SELF inotifywait keeps running.
    inotifywait -m -q -e create,delete,move,delete_self,move_self \
        --format '%e' "$dir" > "$fifo" 2>/dev/null &
    watcher=$!

    while read -r events; do
        # Debounce bursts.
        while read -r -t 0.3 more; do events="$events $more"; done
        refresh
        case "$events" in
            *DELETE_SELF*|*MOVE_SELF*) break ;;
        esac
    done < "$fifo"

    kill "$watcher" 2>/dev/null
    wait "$watcher" 2>/dev/null

    sleep 1
done
