#!/bin/sh
# Rofi menu of occasional system actions. Rows read "Domain: Verb object";
# anything with its own keybind stays out.

dictation_service=voxtype

# Keep the window open after the command (wait-after-command is unreliable
# with ghostty's single-instance daemon).
term() { exec ghostty -e sh -c "$1"'; printf "\n[finished] press Enter to close "; read -r _'; }

# sink_map is "id<TAB>description"; ● marks the current default.
sinks=$(wpctl status | sed -n '/Audio/,/Video/p' | sed -n '/Sinks:/,/Sources:/p')
cur=$(printf '%s\n' "$sinks" | sed -n 's/^[^0-9*]*\*\s*\([0-9]\+\)\..*/\1/p')
sink_map=$(printf '%s\n' "$sinks" \
  | sed -n 's/^[^0-9]*\([0-9]\+\)\.\s*\(.*\S\)\s*\[vol.*/\1\t\2/p')

rows=$(printf '%s\n' "$sink_map" \
  | awk -F'\t' -v cur="$cur" \
      '{printf "Audio: Set output to %s%s\n", $2, ($1 == cur ? " ●" : "")}'
  printf '%s\n' \
    "Dictation: Start service" \
    "Dictation: Stop service" \
    "Disk: Show usage by filesystem" \
    "Disk: Show usage under ~" \
    "Disk: Clean caches, build artifacts and Docker data")

chosen=$(printf '%s\n' "$rows" \
  | rofi -dmenu -i -no-custom -l "$(printf '%s\n' "$rows" | wc -l)" -p "Run") || exit 0
[ -n "$chosen" ] || exit 0

# shellcheck disable=SC2016  # $HOME expands in the terminal's shell
case "$chosen" in
  "Audio: Set output to "*)
    name=${chosen#Audio: Set output to }
    name=${name% ●}
    # Exact match: descriptions contain regex characters.
    id=$(printf '%s\n' "$sink_map" | awk -F'\t' -v n="$name" '$2 == n { print $1; exit }')
    if [ -n "$id" ] && wpctl set-default "$id"; then
      notify-send -e "Audio output" "Default sink: $name"
    else
      notify-send -u critical "Audio output" "Could not switch to $name"
    fi ;;

  "Dictation: Start service")
    if systemctl --user start "$dictation_service"; then
      notify-send -e "Dictation" "$dictation_service started — hold Super+V to dictate"
    else
      notify-send -u critical "Dictation" "Could not start $dictation_service"
    fi ;;
  "Dictation: Stop service")
    if systemctl --user stop "$dictation_service"; then
      notify-send -e "Dictation" "$dictation_service stopped"
    else
      notify-send -u critical "Dictation" "Could not stop $dictation_service"
    fi ;;

  "Disk: Show usage by filesystem") term 'duf' ;;
  "Disk: Show usage under ~")       term 'dust "$HOME"' ;;
  "Disk: Clean caches, build artifacts and Docker data") term '"$HOME"/.local/bin/system-cleanup' ;;
esac
