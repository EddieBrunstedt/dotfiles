#!/usr/bin/env bash
# jf - query the local Jellyfin server from the terminal
# The API key comes from the vault (sec JELLYFIN_TOKEN); JELLYFIN_URL overrides
# the server, which is this machine.

set -euo pipefail

JELLYFIN_URL=${JELLYFIN_URL:-http://127.0.0.1:8096}
JELLYFIN_TOKEN=

api() {
  local path=$1; shift
  # Header on stdin: curl's argv is readable by every process in /proc.
  curl -sS --fail-with-body -m 30 -H @- \
    "$@" "$JELLYFIN_URL$path" <<<"Authorization: MediaBrowser Token=$JELLYFIN_TOKEN"
}

# Fields requested for any item listing that reports metadata health.
FIELDS='ProviderIds,Path,DateCreated,Overview,Genres'

libs() { api "/Library/VirtualFolders"; }

# Map a library's collection type -> "<item types> <matchable against a provider?>"
types_for() {
  case "$1" in
    movies)                 echo "Movie yes" ;;
    tvshows)                echo "Series yes" ;;
    music)                  echo "MusicAlbum yes" ;;
    homevideos|musicvideos) echo "Video no" ;;
    *)                      echo "Movie,Series,Video yes" ;;
  esac
}

cmd_libraries() {
  libs | jq -r '["LIBRARY","TYPE","ID","PATH"], (.[]|[.Name,.CollectionType,.ItemId,(.Locations|join(","))]) | @tsv' | column -t -s $'\t'
}

cmd_status() {
  api "/System/Info" | jq -r '"Server: \(.ServerName)  v\(.Version)  pending-restart:\(.HasPendingRestart)"'
  echo
  printf "%-12s %-10s %6s %8s %8s\n" LIBRARY TYPE ITEMS NOMATCH NOIMAGE
  libs | jq -r '.[]|[.ItemId,.Name,.CollectionType]|@tsv' | while IFS=$'\t' read -r id name ctype; do
    read -r types matchable <<<"$(types_for "$ctype")"
    read -r total nomatch noimg < <(
      api "/Items?ParentId=$id&Recursive=true&IncludeItemTypes=$types&Fields=$FIELDS&Limit=2000" \
      | jq -r '[.TotalRecordCount,
                ([.Items[]|select((.ProviderIds//{}|keys|length)==0)]|length),
                ([.Items[]|select(.ImageTags.Primary==null)]|length)] | @tsv'
    )
    # Home-video libraries have no online provider to match against.
    [[ $matchable == no ]] && nomatch="n/a"
    printf "%-12s %-10s %6s %8s %8s\n" "$name" "$types" "$total" "$nomatch" "$noimg"
  done
}

# Items that failed to match a provider or have no poster.
# Extras (Featurettes/, Extras/, ...) are excluded: they never match a provider by design.
cmd_problems() {
  libs | jq -r '.[]|[.ItemId,.Name,.CollectionType]|@tsv' | while IFS=$'\t' read -r id name ctype; do
    read -r types matchable <<<"$(types_for "$ctype")"
    api "/Items?ParentId=$id&Recursive=true&IncludeItemTypes=$types&Fields=$FIELDS&Limit=2000" \
    | jq -r --arg lib "$name" --arg matchable "$matchable" '
        .Items[]
        | select((.Path // "") | test("/(Featurettes|Extras|Specials|Behind The Scenes|Deleted Scenes|Interviews|Scenes|Shorts|Trailers|Other)/"; "i") | not)
        | select(
            ($matchable == "yes" and ((.ProviderIds//{}|keys|length) == 0))
            or (.ImageTags.Primary == null)
            or ($matchable == "yes" and (.Overview == null)))
        | "[\($lib)] \(.Name) (\(.ProductionYear//"?"))
    match:\(if (.ProviderIds//{}|keys|length)>0 then (.ProviderIds|keys|join(",")) else "NONE" end)  poster:\(if .ImageTags.Primary then "ok" else "MISSING" end)  overview:\(if .Overview then "ok" else "MISSING" end)
    \(.Path)"'
  done
  echo "(no output above means every item matched and has artwork)"
}

# Most recently added items, with metadata state. Usage: jf recent [count]
cmd_recent() {
  local limit=${1:-15}
  api "/Items?Recursive=true&IncludeItemTypes=Movie,Series,Episode,Video&Fields=$FIELDS&SortBy=DateCreated&SortOrder=Descending&Limit=$limit" \
  | jq -r '.Items[] | "\(.DateCreated[0:16])  \(.Type|.[0:6])  \(.Name) (\(.ProductionYear//"?"))
    match:\(if (.ProviderIds//{}|keys|length)>0 then (.ProviderIds|keys|join(",")) else "NONE" end)  poster:\(if .ImageTags.Primary then "ok" else "MISSING" end)  art:\(.BackdropImageTags|length)"'
}

# Full detail for one item. Usage: jf show "Yi Yi"
cmd_show() {
  local q=${1:?usage: jf show <name>}
  api "/Items?Recursive=true&SearchTerm=$(jq -rn --arg s "$q" '$s|@uri')&Fields=$FIELDS,Studios,People,MediaSources&Limit=5" \
  | jq -r '.Items[] | "── \(.Name) (\(.ProductionYear//"?"))  [\(.Type)]",
      "   id:        \(.Id)",
      "   providers: \(if (.ProviderIds//{}|keys|length)>0 then (.ProviderIds|to_entries|map("\(.key)=\(.value)")|join("  ")) else "NONE" end)",
      "   images:    \(.ImageTags//{}|keys|join(",")) + \(.BackdropImageTags|length) backdrop",
      "   genres:    \(.Genres//[]|join(", "))",
      "   overview:  \(if .Overview then (.Overview[0:100]+"...") else "MISSING" end)",
      "   added:     \(.DateCreated//"?")",
      "   path:      \(.Path//"?")", ""'
}

# Trigger a library scan (whole server).
cmd_scan() {
  api "/Library/Refresh" -X POST -o /dev/null
  echo "Scan triggered. Follow with:  jf tasks   or   jf log"
}

# Running tasks (scan progress) plus anything that failed on its last run.
cmd_tasks() {
  local out
  out=$(api "/ScheduledTasks" \
    | jq -r '.[] | select(.State != "Idle" or (.LastExecutionResult.Status? // "Completed") == "Failed")
        | "\(.Name): \(.State)\(if .CurrentProgressPercentage then " \(.CurrentProgressPercentage|floor)%" else "" end) last=\(.LastExecutionResult.Status? // "never run")"')
  if [[ -z $out ]]; then
    echo "No task running; none failed on its last run."
  else
    echo "$out"
  fi
}

cmd_log() { journalctl -u jellyfin -n "${1:-40}" --no-pager -o cat; }

cmd_help() {
  cat <<'EOF'
jf - Jellyfin from the terminal

  jf status            per-library counts + how many items lack metadata/artwork
  jf libraries         configured libraries, their type and folder
  jf problems          list every item missing a provider match, poster, or overview
  jf recent [N]        newest N items with their metadata state (default 15)
  jf show <name>       full metadata detail for one title (IDs, images, path)
  jf scan              trigger a library scan
  jf tasks             running/failed scheduled tasks (scan progress)
  jf log [N]           last N lines of the Jellyfin service log
EOF
}

# Once, up front: api runs in subshells, which can't hand a value back.
case "${1:-help}" in
  status|libraries|libs|problems|recent|show|scan|tasks) JELLYFIN_TOKEN=$(sec JELLYFIN_TOKEN) ;;
esac

case "${1:-help}" in
  status)    shift; cmd_status "$@" ;;
  libraries|libs) shift; cmd_libraries "$@" ;;
  problems)  shift; cmd_problems "$@" ;;
  recent)    shift; cmd_recent "$@" ;;
  show)      shift; cmd_show "$@" ;;
  scan)      shift; cmd_scan "$@" ;;
  tasks)     shift; cmd_tasks "$@" ;;
  log)       shift; cmd_log "$@" ;;
  help|-h|--help) cmd_help ;;
  *) echo "jf: unknown command '$1'" >&2; cmd_help; exit 1 ;;
esac
