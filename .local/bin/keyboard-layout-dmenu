#!/bin/sh
#Set white temperatature with redshift and dmenu

list="us (English)\nse (Swedish)\ndk (Danish)"

chosen=$(echo -e $list | dmenu -i -b -fn 'monospace:size=11' -nb '#1E1D2F' -sb '#4a4a58' -sf '#D9E0EE' -l 3)

[ "$chosen" != "" ] || exit

echo $chosen | head -n1 | awk '{print $1;}'

layout=$(echo "$chosen" | head -n1 | awk '{print $1;}')

setxkbmap -layout "$layout";
xset r rate 200 50;
