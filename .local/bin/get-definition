#!/bin/sh

# Exit if any command fails and catch failures in pipelines
set -e
set -o pipefail

# Store the current content of the clipboard to a variable
clipboard_content=$(xclip -selection clipboard -o)

# Run the content through Thoth and store the output in a variable
thoth_output=$(thoth prompt --no-new-line definition text="$clipboard_content")

if [ $? -eq 0 ]; then
    notify-send -u normal -i ~/.dotfiles/.config/dunst/icons/thoth.png "Thoth" -- "Word/phrase: <b>$clipboard_content</b>\n\n$thoth_output"
else
    notify-send -u low "Thoth" "Definition check failed."
fi
