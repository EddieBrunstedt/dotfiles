#!/bin/sh
# Switch to US while voxtype types (ydotool sends US keycodes), then restore.

state="${XDG_RUNTIME_DIR:-/tmp}/voxtype-layout.prev"

case "$1" in
hold)
    now=$(kbd-layout current) || exit 0
    printf '%s\n' "$now" >"$state"
    [ "$now" = us ] || kbd-layout set us
    ;;
release)
    [ -f "$state" ] || exit 0
    prev=$(cat "$state")
    rm -f "$state"
    [ -z "$prev" ] || [ "$prev" = us ] || kbd-layout set "$prev"
    ;;
*)
    echo "usage: ${0##*/} hold|release" >&2
    exit 2
    ;;
esac
