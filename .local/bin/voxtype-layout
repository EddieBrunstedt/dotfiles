#!/bin/sh
# Force the US layout while voxtype types, then put the previous layout back.
#
# voxtype's ydotool driver emits raw US keycodes, so whatever layout mango has
# active when the text is typed must be US or punctuation comes out wrong.
# Wired to pre_output_command / post_output_command in
# ~/.config/voxtype/config.toml.
#
# The index passed to switch_keyboard_layout is 1-based and follows the order of
# xkb_rules_layout in ~/.config/mango/config.conf. Keep the two in sync.

state="${XDG_RUNTIME_DIR:-/tmp}/voxtype-layout.prev"
us='English (US)'

current_layout() {
    mmsg get keyboardlayout 2>/dev/null |
        sed -n 's/.*"layout":"\([^"]*\)".*/\1/p'
}

layout_index() {
    case "$1" in
    "$us")    echo 1 ;;
    'Swedish') echo 2 ;;
    'Danish')  echo 3 ;;
    *)         echo '' ;;
    esac
}

case "$1" in
hold)
    now=$(current_layout)
    # No IPC answer means no compositor to switch; leave things alone.
    [ -n "$now" ] || exit 0
    printf '%s\n' "$now" >"$state"
    [ "$now" = "$us" ] && exit 0
    mmsg dispatch switch_keyboard_layout,1 >/dev/null
    ;;
release)
    [ -f "$state" ] || exit 0
    prev=$(cat "$state")
    rm -f "$state"
    [ "$prev" = "$us" ] && exit 0
    index=$(layout_index "$prev")
    [ -n "$index" ] || exit 0
    mmsg dispatch switch_keyboard_layout,"$index" >/dev/null
    ;;
*)
    echo "usage: ${0##*/} hold|release" >&2
    exit 2
    ;;
esac
