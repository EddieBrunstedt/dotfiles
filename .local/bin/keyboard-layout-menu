#!/bin/sh
# Pick a keyboard layout via rofi, from mango's xkb_rules_layout.

rows=$(kbd-layout list | awk -F '\t' '{ printf "%s  %s\n", $1, $2 }')
[ -n "$rows" ] || exit 1

chosen=$(printf '%s\n' "$rows" \
    | rofi -dmenu -i -no-custom -l "$(printf '%s\n' "$rows" | wc -l)" \
        -p "Keyboard layout") || exit 0
[ -n "$chosen" ] || exit 0

exec kbd-layout set "${chosen%% *}"
