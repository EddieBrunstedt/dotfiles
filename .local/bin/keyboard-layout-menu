#!/bin/sh
# Pick a keyboard layout via rofi. Bound to SUPER+SHIFT+k.
#
# The index passed to switch_keyboard_layout is 1-based and follows the order of
# xkb_rules_layout in ~/.config/mango/config.conf. Keep the two in sync.

list='us (English)
se (Swedish)
dk (Danish)'

chosen=$(printf '%s\n' "$list" \
    | rofi -dmenu -i -no-custom -l 3 -p "Keyboard layout") || exit 0
[ -n "$chosen" ] || exit 0

index=$(printf '%s\n' "$list" | grep -nxF "$chosen" | cut -d: -f1)
[ -n "$index" ] || exit 1

mmsg dispatch switch_keyboard_layout,"$index" >/dev/null
