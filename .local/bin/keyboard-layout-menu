#!/bin/sh
# Pick a keyboard layout via rofi. Order must match xkb_rules_layout in mango.

list='us (English)
se (Swedish)
dk (Danish)'

chosen=$(printf '%s\n' "$list" \
    | rofi -dmenu -i -no-custom -l "$(printf '%s\n' "$list" | wc -l)" \
        -p "Keyboard layout") || exit 0
[ -n "$chosen" ] || exit 0

index=$(printf '%s\n' "$list" | grep -nxF "$chosen" | cut -d: -f1)
[ -n "$index" ] || exit 1

mmsg dispatch switch_keyboard_layout,"$index" >/dev/null
