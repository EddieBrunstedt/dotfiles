#!/bin/sh
# Mullvad VPN menu for rofi. Bound to SUPER+SHIFT+s and to the Waybar segment.
# Signals Waybar (RTMIN+2) after any state change so the indicator keeps up.

set -u

SIGNAL=2
NOTIFY_ID=9001
TIMEOUT=30      # seconds to wait for a state transition
LEAVE_WAIT=5    # seconds to wait for a reconnect to drop the tunnel first
POLL=0.25

for dep in rofi mullvad jq notify-send pkill; do
    command -v "$dep" >/dev/null 2>&1 || {
        printf 'mullvad-menu: required command not found: %s\n' "$dep" >&2
        exit 1
    }
done

refresh() { pkill -RTMIN+$SIGNAL -x waybar 2>/dev/null || :; }

# $1 summary, $2 body, $3 urgency. A fixed id means each notification replaces
# the last rather than stacking a transition's worth of popups.
notify() {
    notify-send -e -r "$NOTIFY_ID" -a Mullvad -i mullvad-vpn \
        -u "${3:-normal}" "$1" "${2:-}" >/dev/null 2>&1 || :
}

# rofi -mesg renders pango markup
escape_markup() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# $1 prompt, $2 rows, $3 message
menu() {
    rofi -dmenu -i -no-custom -p "$1" -l "$2" -mesg "$(escape_markup "$3")"
}

status_json() { mullvad status --json 2>/dev/null; }
state_of() { printf '%s' "${1:-}" | jq -r '.state // "unavailable"' 2>/dev/null; }
hostname_of() { printf '%s' "${1:-}" | jq -r '.details.location.hostname // ""' 2>/dev/null; }

location_of() {
    printf '%s' "${1:-}" | jq -r '
        (.details.location // {}) as $l
        | "\($l.city // "Unknown city"), \($l.country // "Unknown country") — \($l.hostname // "unknown relay")"
    ' 2>/dev/null
}

error_of() {
    printf '%s' "${1:-}" | jq -r '
        (.details.cause // .details // "Tunnel entered an error state")
        | if type == "string" then . else tostring end
    ' 2>/dev/null
}

# await <target-state> <require-transition> <expected-country>
# Polls until the tunnel reaches the target state, hits an error, or times out,
# then notifies. require-transition=yes first waits for the tunnel to leave the
# target state, so a reconnect is not satisfied by the connection it replaces.
await() {
    target=$1 require_transition=$2 expected_country=$3
    i=0

    if [ "$require_transition" = yes ]; then
        while [ "$i" -lt $((LEAVE_WAIT * 4)) ]; do
            [ "$(state_of "$(status_json)")" = "$target" ] || break
            sleep "$POLL"
            i=$((i + 1))
        done
    fi

    i=0
    while [ "$i" -lt $((TIMEOUT * 4)) ]; do
        json=$(status_json)
        case "$(state_of "$json")" in
        error)
            notify "⚠ Mullvad" "$(error_of "$json")" critical
            refresh
            return 1
            ;;
        "$target")
            # Landing in the wrong country is a failure worth reporting, so keep
            # waiting rather than announcing a connection that missed the pick.
            if [ -n "$expected_country" ]; then
                case "$(hostname_of "$json")" in
                "$expected_country"-*) ;;
                *)
                    sleep "$POLL"
                    i=$((i + 1))
                    continue
                    ;;
                esac
            fi
            case "$target" in
            connected) notify "🔒 Connected" "$(location_of "$json")" ;;
            disconnected) notify "🔓 Disconnected" ;;
            esac
            refresh
            return 0
            ;;
        esac
        sleep "$POLL"
        i=$((i + 1))
    done

    if [ -n "$expected_country" ]; then
        notify "⚠ Mullvad" "Connected, but country $expected_country was not reached" critical
    else
        notify "⚠ Mullvad" "Timed out waiting for $target" critical
    fi
    refresh
    return 1
}

# transition <target> <require-transition> <expected-country> <summary> <body> <mullvad args...>
transition() {
    target=$1 require_transition=$2 expected_country=$3 summary=$4 body=$5
    shift 5

    notify "$summary" "$body"
    if ! err=$(mullvad "$@" 2>&1); then
        notify "⚠ Mullvad" "${err:-Command failed: mullvad $*}" critical
        refresh
        return 1
    fi
    await "$target" "$require_transition" "$expected_country"
}

auto_connect_state() {
    mullvad auto-connect get 2>/dev/null | sed -n 's/^Autoconnect: \(on\|off\)$/\1/p'
}

set_auto_connect() {
    if ! err=$(mullvad auto-connect set "$1" 2>&1); then
        notify "⚠ Mullvad" "${err:-Could not change auto-connect}" critical
        return 1
    fi
    case "$1" in
    on) notify "🔒 Mullvad" "Auto-connect enabled" ;;
    off) notify "🔒 Mullvad" "Auto-connect disabled" ;;
    esac
}

pick_country() {
    if ! relays=$(LC_ALL=C mullvad relay list 2>&1); then
        notify "⚠ Mullvad" "${relays:-Could not retrieve the relay list}" critical
        return 1
    fi

    countries=$(printf '%s\n' "$relays" | sed -nE 's/^([^[:space:]].*) \(([a-z]{2})\)$/\1 (\2)/p')
    [ -n "$countries" ] || {
        notify "⚠ Mullvad" "No countries found in the relay list" critical
        return 1
    }

    country=$(printf '%s\n' "$countries" \
        | menu "Connect to country" 20 "Choose any relay in a country") || return 0
    [ -n "$country" ] || return 0

    code=$(printf '%s\n' "$country" | sed -nE 's/^.*\(([a-z]{2})\)$/\1/p')
    [ -n "$code" ] || {
        notify "⚠ Mullvad" "Invalid country selection: $country" critical
        return 1
    }

    if ! err=$(mullvad relay set location "$code" 2>&1); then
        notify "⚠ Mullvad" "${err:-Could not select $country}" critical
        return 1
    fi

    transition connected yes "$code" "🔒 Mullvad" "Connecting to $country…" reconnect
}

show_status() {
    if ! out=$(mullvad status -v 2>&1); then
        notify "⚠ Mullvad" "${out:-Daemon unreachable}" critical
        return 1
    fi
    notify "🔒 Mullvad status" "$out"
}

# ── build the menu for the current state ────────────────────────────────────
json=$(status_json)
state=$(state_of "$json")
auto=$(auto_connect_state)

case "$auto" in
on) auto_action="Disable auto-connect" ;;
off) auto_action="Enable auto-connect" ;;
*) auto_action="Toggle auto-connect" ;;
esac

case "$state" in
connected)
    message="Connected: $(location_of "$json")"
    options="Disconnect
Reconnect
Pick country…
Show status
$auto_action"
    ;;
disconnected)
    message="Disconnected"
    options="Connect
Pick country…
Show status
$auto_action"
    ;;
connecting)
    message="Connecting…"
    options="Disconnect
Show status
$auto_action"
    ;;
disconnecting)
    message="Disconnecting…"
    options="Show status
$auto_action"
    ;;
*)
    message="Status unavailable"
    options="Connect
Disconnect
Reconnect
Pick country…
Show status
$auto_action"
    ;;
esac

[ -n "$auto" ] && message="$message
Auto-connect: $auto"

choice=$(printf '%s\n' "$options" | menu "Mullvad" 6 "$message") || exit 0
[ -n "$choice" ] || exit 0

case "$choice" in
Connect) transition connected no "" "🔒 Mullvad" "Connecting…" connect ;;
Disconnect) transition disconnected no "" "🔓 Mullvad" "Disconnecting…" disconnect ;;
Reconnect) transition connected yes "" "🔒 Mullvad" "Reconnecting…" reconnect ;;
"Pick country…") pick_country ;;
"Show status") show_status ;;
"Enable auto-connect") set_auto_connect on ;;
"Disable auto-connect") set_auto_connect off ;;
"Toggle auto-connect")
    case "$(auto_connect_state)" in
    on) set_auto_connect off ;;
    off) set_auto_connect on ;;
    *) notify "⚠ Mullvad" "Could not read the auto-connect setting" critical ;;
    esac
    ;;
esac
