#!/usr/bin/env bash
# Lock, turn the panel off, and turn it back on at the next input.
# Bound to the power key and power-menu. Never suspends.
set -u

warn() { printf 'lock-blank: %s\n' "$1" >&2; }

# Already locked: lock-screen would never signal readiness.
if ! pgrep -x swaylock >/dev/null; then
  # Wait for swaylock's --ready-fd instead of sleeping. The fifo is opened
  # read-write so open() can't block; the read timeout bounds the rest.
  ready=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/lock-blank.XXXXXX")
  if mkfifo -m 600 "$ready" 2>/dev/null && exec 3<>"$ready"; then
    rm -f "$ready"
    "$HOME"/.local/bin/lock-screen --ready-fd 4 4>&3 &
    read -r -t 5 -u 3 _ || :
    exec 3>&-
  else
    warn "could not create the readiness fifo — locking without waiting for it"
    "$HOME"/.local/bin/lock-screen &
    sleep 1
  fi

  # Blank regardless; leaving the panel on wouldn't make it any more locked.
  pgrep -x swaylock >/dev/null || warn "no swaylock running — blanking an UNLOCKED session"
fi

# wlopm (output power) rather than disabling the output, so mango keeps the layout.
wlopm --off '*'

# One-shot: the 1s timeout arms resume, which restores the panel and exits.
# $$ survives exec, so it is swayidle's own pid.
exec swayidle -w \
  timeout 1 'true' \
  resume "/usr/bin/wlopm --on '*'; kill $$"
