#!/bin/sh
# Mullvad VPN status indicator for dwmblocksrs.
# Triggered every N seconds by the bar, and on RTMIN+2 from mullvad-menu.

out=$(mullvad status --json 2>/dev/null) || { printf '🔓 ?'; exit 0; }

state=$(printf '%s' "$out" | jq -r '.state')

case "$state" in
    connected)
        country=$(printf '%s' "$out" | jq -r '.details.location.country')
        printf '🔒 %s' "$country"
        ;;
    connecting)    printf '🔒 …' ;;
    disconnecting) printf '🔓 …' ;;
    disconnected)  printf '🔓' ;;
    *)             printf '🔓 ?' ;;
esac
