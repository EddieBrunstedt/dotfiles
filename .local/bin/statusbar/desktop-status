#!/bin/sh
# Waybar segment for ~/desktop, the scratch drawer. Never hides.
#
#   clean  empty tray, grey    nothing there
#   fresh  full tray, peach    dropped here this boot
#   stale  full tray, red      survived a reboot
#
# Hidden entries count. Signal: RTMIN+6.
set -u

dir="$HOME/desktop"

# nf-md-inbox / nf-md-inbox_full (same width, so the clock doesn't shift)
icon_clean=$(printf '\363\260\232\207')
icon_dirty=$(printf '\363\261\211\262')

# Stores the boot id with the state, so a marker from an older boot is ignored.
marker="${XDG_RUNTIME_DIR:-/tmp}/desktop-status.state"
boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)

# JSON and pango escaping; & must go before <.
json_escape() {
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/&/\&amp;/g' -e 's/</\&lt;/g' \
        | sed -e ':a' -e 'N' -e '$!ba' -e 's/\n/\\n/g'
}

# Atomic write via rename.
remember() {
    printf '%s %s\n' "$boot" "$1" > "$marker.$$" 2>/dev/null \
        && mv -f "$marker.$$" "$marker" 2>/dev/null
    rm -f "$marker.$$" 2>/dev/null
}

[ -d "$dir" ] || { printf '{"text":""}\n'; exit 0; }

names=$(find "$dir" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | LC_ALL=C sort)
count=$(printf '%s' "$names" | grep -c '^')

if [ "$count" -eq 0 ]; then
    remember clean
    printf '{"text":"%s","class":"clean","tooltip":"~/desktop is clean"}\n' "$icon_clean"
    exit 0
fi

# Anything already here on the first look of a boot is stale.
prev=''
seen_boot=''
seen_state=''
[ -r "$marker" ] && read -r seen_boot seen_state < "$marker"
[ "$seen_boot" = "$boot" ] && prev="$seen_state"

case "$prev" in
    clean|fresh) state=fresh ;;
    *)           state=stale ;;
esac
remember "$state"

if [ "$state" = stale ]; then
    header=$(printf '%s item%s left over from a previous boot -- clean it up' \
        "$count" "$([ "$count" -eq 1 ] || echo s)")
else
    header=$(printf '%s item%s dropped in ~/desktop this session' \
        "$count" "$([ "$count" -eq 1 ] || echo s)")
fi

listing=$(printf '%s' "$names" | head -n 12)
if [ "$count" -gt 12 ]; then
    listing=$(printf '%s\n... and %s more' "$listing" "$((count - 12))")
fi

tooltip=$(printf '%s\n%s' "$header" "$listing" | json_escape)

printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$icon_dirty" "$state" "$tooltip"
