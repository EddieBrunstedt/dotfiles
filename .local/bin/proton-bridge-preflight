#!/bin/sh
# ExecStartPre for protonmail-bridge: wait for the VPN and the API, since
# Bridge's first login fails without them. Always exits 0.
set -u

# Keep well under the unit's TimeoutStartSec (90s).
TIMEOUT=60
API=https://mail-api.proton.me/

vpn_ready() {
    systemctl is-enabled --quiet mullvad-daemon.service 2>/dev/null || return 0
    timeout 2 mullvad status --json 2>/dev/null | jq -e '.state == "connected"' >/dev/null 2>&1
}

api_ready() { curl -sm 2 -o /dev/null "$API"; }

deadline=$(($(date +%s) + TIMEOUT))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if vpn_ready && api_ready; then
        exit 0
    fi
    sleep 1
done

echo "proton-bridge-preflight: timed out after ${TIMEOUT}s; starting anyway" >&2
exit 0
