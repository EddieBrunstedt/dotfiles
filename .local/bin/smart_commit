#!/bin/sh

msg=$(ord run commit_message text="$(git diff -U20 -W --stat --staged)")

echo "Proposed commit message:"
echo "------------------------"
echo "$msg"
echo "------------------------"

read -p "Commit (y), edit (e), or cancel (n)? [y/e/N] " confirm

case "$confirm" in
[Yy])
	git commit -m "$msg"
	;;
[Ee])
	git commit -e -m "$msg"
	;;
*)
	echo "Commit cancelled."
	;;
esac
