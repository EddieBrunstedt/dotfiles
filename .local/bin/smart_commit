#!/bin/bash
set -e

if git diff --cached --quiet; then
	echo "No staged changes."
	exit 1
fi

msg=$(ord run commit_message text="$(git diff -U20 -W --stat --staged -- ':!package-lock.json' ':!yarn.lock' ':!pnpm-lock.yaml')")

echo "Proposed commit message:"
echo "------------------------"
echo "$msg"
echo "------------------------"

read -p "Commit (y), edit (e), or cancel (n)? " c

case "$c" in
[Yy]) git commit -m "$msg" ;;
[Ee]) git commit -e -m "$msg" ;;
*) echo "Cancelled." ;;
esac
