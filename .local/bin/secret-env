#!/bin/sh
# secret-env — manage environment secrets in the Secret Service (gnome-keyring).
#
# Replaces the old ~/.secrets/env plaintext file. Secrets live in the `login`
# keyring, which pam_gnome_keyring unlocks at login (see /etc/pam.d/greetd), so
# reads need no password.
#
# WHY NOT ~/.profile: uwsm's environment preloader sources the POSIX shell
# profile and exports the resulting delta into the systemd *and* D-Bus
# activation environments. Anything exported there lands in the environment of
# every process in the graphical session — Steam, Electron apps, browser
# content processes, the lot. Secrets must therefore never be exported from a
# profile; they belong here, pulled into interactive shells only.
#
# Usage:
#   secret-env list                 names of all stored secrets
#   secret-env get NAME             print one value
#   secret-env set NAME [< file]    store a value (prompts if stdin is a tty)
#   secret-env unset NAME           remove a secret
#   secret-env export [SYNTAX]      emit every secret; SYNTAX is one of
#                                   --sh (default), --fish, or --nul for
#                                   NUL-delimited KEY=value records
#   secret-env refresh              drop the cache (after editing via seahorse)
#   secret-env import FILE          one-shot migration from a KEY=value file
#
# Wire it into fish's interactive startup with:
#   secret-env export --fish | source

set -eu

SCHEMA=dev.nilo.env
TIMEOUT=5
TAB=$(printf '\t')

# Querying the keyring costs one process spawn per key (~76ms for six), which
# would dominate fish's ~22ms startup on every new terminal and tmux pane. The
# rendered output is therefore cached in $XDG_RUNTIME_DIR — tmpfs, mode 0600,
# destroyed by logind at logout, the same trick config.fish uses for fish's
# history. This is not a new exposure: the cache holds exactly the values that
# are about to enter the shell's own environment, readable by the same set of
# processes (i.e. this user's) either way. `set`/`unset` invalidate it; reach
# for `refresh` if you change a secret through seahorse instead.
CACHE_DIR=${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/secret-env}

die() {
	printf 'secret-env: %s\n' "$*" >&2
	exit 1
}

valid_name() {
	# Environment variable names only; keeps `export` output unambiguous.
	case $1 in
	'' | [!A-Za-z_]*) return 1 ;;
	*[!A-Za-z0-9_]*) return 1 ;;
	esac
}

# List the names of all stored secrets, one per line.
#
# `secret-tool search` splits its report across two streams: item metadata
# (label/secret/schema) on stdout, but `attribute.* = ` lines on stderr. We
# only want the names, so read stderr and discard stdout.
#
# A locked or missing keyring must not stall shell startup, so the call is
# bounded by `timeout` and simply yields nothing on failure.
cmd_list() {
	timeout "$TIMEOUT" secret-tool search --all xdg:schema "$SCHEMA" 2>&1 >/dev/null |
		sed -n 's/^attribute\.name = //p' | sort
	return 0
}

# Emit every stored secret as "NAME<TAB>value" lines.
#
# Deliberately one `lookup` per name rather than parsing values out of the
# `search` report: that report's two streams are buffered independently (stdout
# block-buffered through a pipe, stderr unbuffered), so their line order is not
# guaranteed to interleave and pairing a name with a value across them can
# silently mismatch. Costs a few ms per key; not worth risking a swapped key.
dump() {
	cmd_list | while IFS= read -r name; do
		value=$(timeout "$TIMEOUT" secret-tool lookup xdg:schema "$SCHEMA" name "$name" 2>/dev/null) ||
			continue
		[ -n "$value" ] || continue
		printf '%s%s%s\n' "$name" "$TAB" "$value"
	done
}

cmd_get() {
	[ $# -eq 1 ] || die "usage: secret-env get NAME"
	timeout "$TIMEOUT" secret-tool lookup xdg:schema "$SCHEMA" name "$1" ||
		die "no secret named '$1'"
}

# Read one line from stdin without requiring a trailing newline. `read` reports
# failure at EOF even when it filled the variable, so check the value too —
# otherwise `printf '%s' val | secret-env set NAME` would be rejected.
read_value() {
	value=''
	IFS= read -r value || [ -n "$value" ] || return 1
}

cmd_set() {
	[ $# -eq 1 ] || die "usage: secret-env set NAME [< file]"
	name=$1
	valid_name "$name" || die "'$name' is not a valid environment variable name"

	if [ -t 0 ]; then
		printf 'Value for %s: ' "$name" >&2
		stty -echo 2>/dev/null || true
		read_value || { stty echo 2>/dev/null || true; die "no value given"; }
		stty echo 2>/dev/null || true
		printf '\n' >&2
	else
		read_value || die "no value on stdin"
	fi

	[ -n "$value" ] || die "refusing to store an empty value"

	printf '%s' "$value" |
		secret-tool store --label="env: $name" xdg:schema "$SCHEMA" name "$name"
	invalidate_cache
}

cmd_unset() {
	[ $# -eq 1 ] || die "usage: secret-env unset NAME"
	secret-tool clear xdg:schema "$SCHEMA" name "$1"
	invalidate_cache
}

invalidate_cache() {
	[ -n "$CACHE_DIR" ] &&
		rm -f "$CACHE_DIR"/export.sh "$CACHE_DIR"/export.fish "$CACHE_DIR"/export.nul
	return 0
}

cmd_refresh() {
	invalidate_cache
}

render_export() {
	syntax=$1

	# NUL-delimited KEY=value records, for consumers that parse rather than
	# eval — nushell's `load-env`. No quoting or escaping is involved, so a
	# value may contain anything except NUL.
	if [ "$syntax" = nul ]; then
		dump | while IFS="$TAB" read -r name value; do
			printf '%s=%s\0' "$name" "$value"
		done
		return 0
	fi

	dump | while IFS="$TAB" read -r name value; do
		# Both shells read a single-quoted string literally, so only the quote
		# itself needs escaping — plus backslash for fish, which (unlike sh)
		# still honours it inside single quotes. Keys are normally free of
		# both, so the sed call stays off the common path.
		case $value in
		*\'* | *\\*)
			if [ "$syntax" = fish ]; then
				value=$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e "s/'/\\\\'/g")
			else
				value=$(printf '%s' "$value" | sed "s/'/'\\\\''/g")
			fi
			;;
		esac

		if [ "$syntax" = fish ]; then
			printf "set -gx %s '%s'\n" "$name" "$value"
		else
			printf "export %s='%s'\n" "$name" "$value"
		fi
	done
}

cmd_export() {
	syntax="sh"
	case "${1-}" in
	--fish) syntax=fish ;;
	--nul) syntax=nul ;;
	--sh | '') ;;
	*) die "unknown syntax '$1' (expected --fish, --sh or --nul)" ;;
	esac

	if [ -z "$CACHE_DIR" ]; then
		render_export "$syntax"
		return 0
	fi

	cache=$CACHE_DIR/export.$syntax
	if [ -s "$cache" ]; then
		cat "$cache"
		return 0
	fi

	(umask 077 && mkdir -p "$CACHE_DIR")
	tmp=$cache.$$
	trap 'rm -f "$tmp"' EXIT INT TERM
	(umask 077 && render_export "$syntax" >"$tmp")

	# Never cache an empty render: that means the keyring was locked or absent,
	# and the next shell should retry rather than inherit the blank result.
	if [ -s "$tmp" ]; then
		mv -f "$tmp" "$cache"
		cat "$cache"
	else
		rm -f "$tmp"
	fi
}

cmd_import() {
	[ $# -eq 1 ] || die "usage: secret-env import FILE"
	[ -f "$1" ] || die "no such file: $1"

	count=0
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		'' | '#'*) continue ;;
		*=*) ;;
		*) continue ;;
		esac

		key=${line%%=*}
		key=${key# }
		key=${key#export }
		key=${key# }
		valid_name "$key" || continue

		# Strip one layer of surrounding quotes, matching shell semantics.
		value=${line#*=}
		case $value in
		\"*\") value=${value#\"} value=${value%\"} ;;
		\'*\') value=${value#\'} value=${value%\'} ;;
		esac

		printf '%s' "$value" | cmd_set "$key"
		printf 'imported %s\n' "$key" >&2
		count=$((count + 1))
	done <"$1"

	printf '\nimported %d secret(s)\n' "$count" >&2
}

command -v secret-tool >/dev/null 2>&1 ||
	die "secret-tool not found (install libsecret)"

case "${1-}" in
list) shift; cmd_list "$@" ;;
get) shift; cmd_get "$@" ;;
set) shift; cmd_set "$@" ;;
unset) shift; cmd_unset "$@" ;;
export) shift; cmd_export "$@" ;;
refresh) shift; cmd_refresh "$@" ;;
import) shift; cmd_import "$@" ;;
-h | --help | '')
	sed -n '15,25p' "$0" | sed 's/^#\{1,\} \{0,1\}//'
	;;
*) die "unknown command '$1' (try --help)" ;;
esac
