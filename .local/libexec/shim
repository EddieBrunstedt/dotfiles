#!/bin/sh
# Secret-injecting shim. Run via a symlink in ~/.local/bin/shims named after
# the tool: exports the secrets `manifest` lists for it, then execs the real
# binary. See ~/.secret/README.md.
set -eu

# $0 is the symlink, so $dir is the shims directory.
name=${0##*/}
dir=$(dirname -- "$0")
manifest=${SHIM_MANIFEST:-$dir/manifest}

# By location: $PATH is unreliable under systemd units.
sec=$dir/../sec
[ -x "$sec" ] || sec=sec

[ -f "$manifest" ] || { echo "shim: no manifest at $manifest" >&2; exit 1; }

# tool, real binary, secret names...
entry=$(awk -v n="$name" '$1 == n { print; exit }' "$manifest")
[ -n "$entry" ] || { echo "shim: no manifest entry for '$name'" >&2; exit 1; }

real=$(printf '%s\n' "$entry" | awk '{ print $2 }')
case $real in
    \~/*) real="$HOME/${real#\~/}" ;;
esac
[ -x "$real" ] || { echo "shim: '$name' target not executable: $real" >&2; exit 1; }

for var in $(printf '%s\n' "$entry" | awk '{ for (i = 3; i <= NF; i++) print $i }'); do
    # Separate assignment so set -e catches a failing sec.
    val=$("$sec" "$var")
    export "$var=$val"
done

exec "$real" "$@"
