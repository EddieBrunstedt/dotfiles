#!/bin/bash

# Script to display LAN and WAN IP addresses with Mullvad VPN connection status.

# Print header
echo "================================"
echo "      NETWORK IP ADDRESSES      "
echo "================================"

# Get LAN IP address (for all interfaces except lo)
echo -e "\n[LAN IP Addresses]"
ip -4 addr show | grep -v "127.0.0.1" | grep "inet" | awk '{print $NF " : " $2}' | cut -d/ -f1

# Get WAN IP and VPN status using Mullvad
echo -e "\n[WAN IP Information]"

# Fetch data from Mullvad API
mullvad_response=$(curl -s https://am.i.mullvad.net/json)

if [ -n "$mullvad_response" ]; then
    # Parse JSON with jq
    wan_ip=$(echo "$mullvad_response" | jq -r '.ip')
    country=$(echo "$mullvad_response" | jq -r '.country')
    city=$(echo "$mullvad_response" | jq -r '.city')
    is_mullvad=$(echo "$mullvad_response" | jq -r '.mullvad_exit_ip')
    organization=$(echo "$mullvad_response" | jq -r '.organization')

    # Display information
    echo "IP Address: $wan_ip"

    # Display VPN status
    if [ "$is_mullvad" = "true" ]; then
        echo "Mullvad Status: CONNECTED"
    else
        echo "Mullvad Status: NOT CONNECTED"
    fi

    # Display location if available
    if [ "$city" != "null" ] && [ "$country" != "null" ]; then
        echo "Location: $city, $country"
    fi

    # Display organization if available
    if [ "$organization" != "null" ]; then
        echo "Network: $organization"
    fi
else
    # Fallback to simpler endpoint if JSON request failed
    wan_ip=$(curl -s https://am.i.mullvad.net/ip)
    mullvad_status=$(curl -s https://am.i.mullvad.net/connected)

    if [ -n "$wan_ip" ]; then
        echo "IP Address: $wan_ip"

        if [[ "$mullvad_status" == *"You are connected to Mullvad"* ]]; then
            echo "Mullvad Status: CONNECTED"
        else
            echo "Mullvad Status: NOT CONNECTED"
        fi
    else
        echo "Unable to determine WAN IP address"
    fi
fi

echo -e "\n================================"
