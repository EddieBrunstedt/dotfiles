[alias]
	last = log -1 HEAD
	sync = checkout master && git fetch --all -p && git pull
[core]
	pager = delta
	editor = nvim
[credential]
	helper = store
[delta]
	navigate = true
	dark = true
	features = line-numbers decorations hunk-header-decoration-style="grey ul"
[diff]
	tool = bc
[github]
	user = EddieBrunstedt
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = zdiff3
[user]
	email = eddie.brunstedt@protonmail.com
	name = Eddie Brunstedt
