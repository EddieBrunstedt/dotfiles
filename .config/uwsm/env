# Graphical-session environment, sourced by uwsm before the compositor starts
# and exported to systemd and D-Bus activation. See README.md.

# ── NVIDIA ──
export GBM_BACKEND=nvidia-drm
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export LIBVA_DRIVER_NAME=nvidia

# ── Wayland ──
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QT_QPA_PLATFORM='wayland;xcb'
# Not set: SDL_VIDEODRIVER (breaks some games), XDG_SESSION_TYPE and
# XDG_CURRENT_DESKTOP (the session sets them).

# ── Xwayland ──
# Java GUI apps render grey under a non-reparenting WM without this.
export _JAVA_AWT_WM_NONREPARENTING=1
