# Only settings that differ from dunst's defaults; see dunst(5).
# Styled after waybar: Catppuccin Mocha, Maple Mono, 6px radius, 4px gaps.

[global]

    ### Placement ###

    # Right edge, vertically centered, stacking upward.
    origin = bottom-right
    offset = (16, 460)
    # Fixed so the rule line in format spans the text.
    width = 440
    notification_limit = 5
    # Newest at the bottom, so SUPER+i (position 0) works oldest first.
    sort = update
    gap_size = 4
    separator_height = 0

    ### Card ###

    frame_width = 1
    corner_radius = 6
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 12

    ### Text ###

    font = monospace 11
    markup = full
    # App name, summary, a rule line, body.
    format = "<span size='small' foreground='#6c7086'>%a</span>\n<b>%s</b>\n<span foreground='#45475a'>────────────────────────────────────────</span>\n<span foreground='#bac2de'>%b</span>"
    show_indicators = no

    ### Icons ###

    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 32

    ### Behavior ###

    history_length = 1000
    dmenu = /usr/bin/rofi -dmenu -i -no-custom -p dunst:
    mouse_left_click = do_action, close_current

    ### Progress bar ###

    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    highlight = "#b4befe"

# Normal and critical stay until dismissed; low ones time out.
[urgency_low]
    timeout = 20s
    background = "#1e1e2e"
    foreground = "#6c7086"
    frame_color = "#313244"

[urgency_normal]
    timeout = 0
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#45475a"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"

# notify-send -e confirmations time out, unless critical (Mullvad marks everything transient).
[transient]
    match_transient = yes
    timeout = 5s

[transient_critical]
    match_transient = yes
    msg_urgency = critical
    timeout = 0

# Ghostty sends no app name.
[ghostty]
    desktop_entry = com.mitchellh.ghostty
    format = "<span size='small' foreground='#6c7086'>Ghostty</span>\n<b>%s</b>\n<span foreground='#45475a'>────────────────────────────────────────</span>\n<span foreground='#bac2de'>%b</span>"

# Every card gets an icon, so text width (and the rule line) is constant.
[fallback_icon]
    default_icon = ~/.config/dunst/icons/feather.svg
