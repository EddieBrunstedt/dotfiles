# Only settings that differ from dunst's built-in defaults. Anything omitted
# falls back to the default. Full option list: dunst(5).
#
# dunst's built-in defaults are not the same as the shipped /etc/dunst/dunstrc,
# which itself overrides several of them. That file is not read once this one
# exists, so it is not a reference for what is default.

[global]

    ### Display ###

    # Follow the pointer across monitors; this overrides `monitor`.
    follow = mouse
    offset = (10,10)
    # Dynamic width up to 800; long single-line notifications stay readable.
    width = (0, 800)

    ### Text ###

    font = sans-serif 11
    # Default is `no`, which also drops body-markup from the advertised D-Bus
    # capabilities. Required for the default `format`, which wraps %s in <b>.
    markup = full
    vertical_alignment = top

    ### Appearance ###

    frame_width = 2
    frame_color = "#7d7d7d"
    corner_radius = 5

    ### Icons ###

    # Off by default. Resolves icons by theme name rather than through icon_path.
    enable_recursive_icon_lookup = true
    # Equal min and max pins every icon to one size regardless of what is sent.
    min_icon_size = 64
    max_icon_size = 64

    ### History ###

    # Deep history so `dunstctl history-pop` can still reach notifications
    # cleared by lock-screen or SUPER+SHIFT+i.
    history_length = 1000

    ### Misc ###

    # Actions and URL menus render through rofi, matching the other menus.
    dmenu = /usr/bin/rofi -dmenu -i -no-custom -p dunst:

    ### Mouse ###
    # Defaults are close_current / "do_action, remove_current" / close_all.
    mouse_left_click = do_action
    mouse_middle_click = context
    mouse_right_click = close_current

[urgency_low]
    background = "#121212"
    foreground = "#d1d1d1"
    frame_color = "#7d7d7d"
    timeout = 6

[urgency_normal]
    background = "#121212"
    foreground = "#d1d1d1"
    frame_color = "#787bde"

[urgency_critical]
    background = "#121212"
    foreground = "#e35f5f"
    frame_color = "#e35f5f"
