#!/bin/sh

# File operations
alias \
    cp="cp -iv" \
    mv="mv -iv" \
    rm="rm -v" \
    mkd="mkdir -pv"

# List and browse directories
alias \
    l="eza --group-directories-first" \
    ls="eza --group-directories-first" \
    ll="eza -l --group-directories-first --time-style=iso" \
    lll="eza -lgh --group-directories-first --git --time-style=long-iso" \
    la="eza -la --group-directories-first" \
    lt="eza --long --tree" \
    lf="lfcd" \
    bf="br --only-folders" \
    br="br --hidden"

# Text and file viewers
alias \
    bat="bat --style=header --style=auto --theme base16" \
    ccat="highlight --out-format=ansi" \
    diff="diff --color=auto" \
    grep="grep --color=auto" \
    man="batman"

# Editors and development tools
alias \
    e="$EDITOR" \
    f="$FILE" \
    vim="nvim" \
    lg="lazygit"

# System operations
alias \
    ka="killall" \
    sdn="sudo shutdown -h now" \
    d=devour

# Tmux
alias \
    t="tmux" \
    tkill="tmux kill-server" \
    mc="tmux split -h lf; lf"

# Media and download
alias \
    ffmpeg="ffmpeg -hide_banner" \
    yt="yt-dlp -N 5 --add-metadata -i --restrict-filenames" \
    yta="yt-dlp -x -N 5"

# Clipboard
alias \
    pbpaste='xclip -o -sel primary'

# Miscellaneous
alias \
    eco="ledger -f $HOME/economy/index.dat" \
    weather="curl -s wttr.in/Copenhagen"

alias nvm="fnm"

alias notes="cd $HOME/notes/obsidian_vaults/main && nvim"
