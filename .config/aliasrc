#!/bin/sh

# Use neovim for vim if present.
command -v nvim >/dev/null && alias vim="nvim" vimdiff="nvim -d"

# Git helper for dotfiles
alias \
	config='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME' \
	pbpaste='xclip -o -sel primary'

# Flags
alias \
	bat="bat --style=header --style=auto --theme base16" \
	ccat="highlight --out-format=ansi" \
	cp="cp -iv" \
	diff="diff --color=auto" \
	ffmpeg="ffmpeg -hide_banner" \
	grep="grep --color=auto" \
	mkd="mkdir -pv" \
	mv="mv -iv" \
	rm="rm -v" \
	eco="ledger -f $HOME/economy/main.dat"

# Use exa instead of ls
alias \
	l="exa --group-directories-first" \
	ls="exa --group-directories-first" \
	ll="exa -l --group-directories-first" \
	la="exa -la --group-directories-first" \
	lt="exa --long --tree"

# Shortcuts
alias \
	P="sudo pacman" \
	S="sudo" \
	YT="youtube-viewer" \
	d=devour \
	draw="devour krita --new-image RGBA,U8,4096,2160 --workspace Big_Paint_2 --nosplash" \
	e="$EDITOR" \
	f="$FILE" \
	ka="killall" \
	mc="tmux split -h lf; lf" \
	p="pacman" \
	sdn="sudo shutdown -h now" \
	t="tmux" \
	yt="youtube-dl --add-metadata -i" \
	yta="youtube-dl -x" \
	print256colors="curl -s https://gist.githubusercontent.com/HaleTom/89ffe32783f89f403bba96bd7bcd1263/raw/ | bash"

# Weather
alias \
	weather="curl -s wttr.in/Copenhagen"

# Git Aliases
alias \
alias ga='git add' \
alias gaa='git add .' \
alias gaaa='git add --all' \
alias gau='git add --update' \
alias gb='git branch' \
alias gbd='git branch --delete ' \
alias gc='git commit' \
alias gcm='git commit --message' \
alias gcf='git commit --fixup' \
alias gco='git checkout' \
alias gcob='git checkout -b' \
alias gcom='git checkout master' \
alias gcos='git checkout staging' \
alias gcod='git checkout develop' \
alias gd='git diff' \
alias gda='git diff HEAD' \
alias gi='git init' \
alias glg='git log --graph --oneline --decorate --all' \
alias gld='git log --pretty=format:"%h %ad %s" --date=short --all' \
alias gm='git merge --no-ff' \
alias gma='git merge --abort' \
alias gmc='git merge --continue' \
alias gp='git pull' \
alias gpr='git pull --rebase' \
alias gr='git rebase' \
alias gs='git status' \
alias gss='git status --short' \
alias gst='git stash' \
alias gsta='git stash apply' \
alias gstd='git stash drop' \
alias gstl='git stash list' \
alias gstp='git stash pop' \
alias gsts='git stash save'

# Git Functions
# Git log find by commit message
function glf() { git log --all --grep="$1"; }

# Pacman's more sensible half
pacwoman-list-with-size () { pacman -Qi | awk '/^Name/{name=$3} /^Installed Size/{print $4$5, name}' | sort -h; }
pacwoman-download-size () { expac -S -H M '%k\t%n' $1;}
pacwoman-recently-installed () { expac --timefmt='%Y-%m-%d %T' '%l\t%n' | sort | tail -n 20; }
pacwoman-explicitly-installed () { expac -H M '%-20n\t%10d' $(comm -23 <(pacman -Qqt | sort) <({ pacman -Qqg base-devel; expac -l '\n' '%E' base; } | sort -u)); }
pacwoman-explicitly-installed-with-size () { expac -H M "%011m\t%-20n\t%10d" $(comm -23 <(pacman -Qqen | sort) <({ pacman -Qqg base-devel; expac -l '\n' '%E' base; } | sort | uniq)) | sort -n; }
pacwoman-search-and-preview () { pacman -Qq | fzf --preview 'pacman -Qil {}' --layout=reverse --bind 'enter:execute(pacman -Qil {} | bat)'; }
pacwoman-owned-files () { pacman -Qlq $1 | grep -v '/$' | xargs -r du -h | sort -h; }
pacwoman-check-unowned-files-lostfiles () { sudo lostfiles; }
pacwoman-check-unowned-files-pacreport () { sudo pacreport --unowned-files; }
pacwoman-remove-orphans () { sudo pacman -Rns $(pacman -Qtdq); }
pacwoman-patch-notes () { pacolog -l 10 $1; }
pacwoman-set-up-hq () { sudo paru -S --noconfirm - < $HOME/.config/applist; }
pacwoman-set-up-hq-aur () { paru -S --noconfirm --aur - < $HOME/.config/applist-aur;  }
pacwoman-clean-house () { sudo rm -rf /var/cache/; rm -rf $HOME/.cache/yay; sudo pacman -Sccd --noconfirm; }
pacwoman-file-owned-by-which-package () { pacman -Qo $1; }
