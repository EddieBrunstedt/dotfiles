#!/bin/sh

# Use neovim for vim if present.
command -v nvim >/dev/null && alias vim="nvim" vimdiff="nvim -d"

# Git helper for dotfiles
alias \
	config='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME'

# Flags
alias \
	cp="cp -iv" \
	mv="mv -iv" \
	rm="rm -v" \
	mkd="mkdir -pv" \
	ffmpeg="ffmpeg -hide_banner" \
	grep="grep --color=auto" \
	diff="diff --color=auto" \
	ccat="highlight --out-format=ansi"

# Use exa instead of ls
alias \
	l="exa --group-directories-first" \
	ls="exa --group-directories-first" \
	ll="exa -l --group-directories-first" \
	la="exa -la --group-directories-first" \
	lt="exa --long --tree"

# Shortcuts
alias \
	draw="krita --new-image RGBA,U8,4096,2160 --workspace Big_Paint_2 --nosplash" \
	t="tmux" \
	ka="killall" \
	sdn="sudo shutdown -h now" \
	f="$FILE" \
	e="$EDITOR" \
	p="pacman" \
	P="sudo pacman" \
	yt="youtube-dl --add-metadata -i" \
	yta="youtube-dl -x -f bestaudio/best" \
	YT="youtube-viewer"

# Weather
alias \
	weather="less -S ~/.local/share/weatherreport"


# Pacman's more sensible half
pacwoman-list-with-size () { pacman -Qi | awk '/^Name/{name=$3} /^Installed Size/{print $4$5, name}' | sort -h; }
pacwoman-download-size () { expac -S -H M '%k\t%n' $1;}
pacwoman-recently-installed () { expac --timefmt='%Y-%m-%d %T' '%l\t%n' | sort | tail -n 20; }
pacwoman-explicitly-installed () { expac -H M '%-20n\t%10d' $(comm -23 <(pacman -Qqt | sort) <({ pacman -Qqg base-devel; expac -l '\n' '%E' base; } | sort -u)); }
pacwoman-explicitly-installed-with-size () { expac -H M "%011m\t%-20n\t%10d" $(comm -23 <(pacman -Qqen | sort) <({ pacman -Qqg base-devel; expac -l '\n' '%E' base; } | sort | uniq)) | sort -n; }
pacwoman-search-and-preview () { pacman -Qq | fzf --preview 'pacman -Qil {}' --layout=reverse --bind 'enter:execute(pacman -Qil {} | less)'; }
pacwoman-owned-files () { pacman -Qlq $1 | grep -v '/$' | xargs -r du -h | sort -h; }
pacwoman-check-unowned-files-lostfiles () { sudo lostfiles; }
pacwoman-check-unowned-files-pacreport () { sudo pacreport --unowned-files; }
pacwoman-remove-orphans () { sudo pacman -Rns $(pacman -Qtdq); }
pacwoman-patch-notes () { pacolog -l 10 $1; }
pacwoman-set-up-hq () { sudo pacman -S --needed - < $HOME/.config/applist; }
pacwoman-set-up-hq-aur () { yay -S --needed --noconfirm --aur --removemake --nocleanmenu --nodiffmenu --noeditmenu - < $HOME/.config/applist-aur; }
