#!/bin/sh

# File operations
alias \
    cp="cp -iv" \
    mv="mv -iv" \
    rm="rm -v" \
    mkd="mkdir -pv"

# List and browse directories
alias \
    l="eza --group-directories-first" \
    ls="eza --group-directories-first" \
    ll="eza -l --group-directories-first --time-style=iso" \
    lll="eza -lgh --group-directories-first --git --time-style=long-iso" \
    la="eza -la --group-directories-first" \
    lt="eza --long --tree"

# Text and file viewers
alias \
    ccat="highlight --out-format=ansi" \
    diff="diff --color=auto" \
    grep="grep --color=auto" \
    man="batman"

# Editors and development tools
alias \
    vim="nvim" \
    lg="lazygit"

# System operations
alias \
    ka="killall" \
    sdn="sudo shutdown -h now"

# Tmux
alias \
    t="tmux" \
    tkill="tmux kill-server"

# Media and download
alias \
    ffmpeg="ffmpeg -hide_banner" \
    yt="yt-dlp -N 5 --add-metadata -i --restrict-filenames" \
    yta="yt-dlp -x -N 5"

alias nvm="fnm"
