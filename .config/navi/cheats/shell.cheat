% shell

# Kill process
killall <running_process_name>

# Kill process running on a given port
lsof -i :<port> \
   | awk '{l=$2} END {print l}' \
   | xargs kill

# Disk usage overview (erdtree)
erd --icons --long --human --level 3 /

# Disk usage overview (ncdu)
ncdu --color off

$ running_process_name: ps -A | awk '{ print $4 }'
