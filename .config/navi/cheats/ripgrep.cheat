% ripgrep (rg)

# Search for a string in files within a directory
rg<case><count> "<term>" <path>

# Search for a string in files within a directory (filter by extension)
rg<case><count> -g "*.<extension>" "<term>" <path>

$ case: echo 'case-sensitive case-insensitive' | tr ' ' '\n' --- --map "grep -q 'case-insensitive' && echo ' -i' || echo ''"
$ count: echo 'false true' | tr ' ' '\n' --- --map "grep -q t && echo ' -c' || echo ''"
