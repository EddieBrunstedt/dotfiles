% pacman

# List size of installed packages with size
pacman -Qi | awk '/^Name/{name=$3} /^Installed Size/{print $4$5, name}' | sort -h

# Check size of remote package
expac -S -H M '%k\t%n' <package>

# List recently installed packages
expac --timefmt='%Y-%m-%d %T' '%l\t%n' | sort | tail -n 20

# List explicitly installed packages with description
expac -Q '%n - %d' $(paru -Qeq)

# Search and preview installed packages
pacman -Qq | fzf --preview 'pacman -Qil {}' --layout=reverse --bind 'enter:execute(pacman -Qil {} | bat)'

# List files owned by package
pacman -Qlq <pkg_name_installed> | grep -v '/$' | xargs -r du -h | sort -h

# List unowned or lost files
sudo lostfiles

# List unowned or lost files (pacreport)
sudo pacreport --unowned-files

# Remove all orphans
sudo pacman -Qtdq | sudo pacman -Rns -

# Install all packages from applist
sudo paru -S --needed --noconfirm - < $HOME/.config/applist

# Install all packages from applist-aur
paru -S --aur --needed --noconfirm - < $HOME/.config/applist-aur

# Clean up all local caches
sudo pacman -Scc

# Check which package owns a file
pacman -Qo <file>

# Install a package
sudo pacman -S <pkg_name>

# Remove a package
sudo pacman -Rns <pkg_name_installed>

# System upgrade
paru -Syu --devel --newsonupgrade --combinedupgrade --cleanafter --noconfirm && rustup update --no-self-update

$ pkg_name_installed: sudo pacman -Qe | awk '{ print $1 }'
