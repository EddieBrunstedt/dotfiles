# ── Font ──
font-family = "monospace"
font-size = 12.5

# Maple Mono italics: break the connecting strokes, straighten ambiguous letters.
font-feature = ss06
font-feature = cv33
font-feature = cv34
font-feature = cv35
font-feature = cv36

# Maple Mono upright: distinct a, comma, semicolon; open question mark.
font-feature = ss05
font-feature = cv01
font-feature = cv02
font-feature = cv61
font-feature = cv62

# ── Look ──
theme = Modus Vivendi Tinted
minimum-contrast = 1.1

window-decoration = none
window-padding-balance = true
window-padding-x = 3
window-padding-y = 3
window-padding-color = extend
resize-overlay = never

# ── Behavior ──
confirm-close-surface = false
quit-after-last-window-closed = false
scrollback-limit = 50000000
shell-integration-features = cursor,sudo,title,ssh-terminfo,path

# ── Keys ──
keybind = ctrl+enter=unbind

keybind = alt+y=scroll_page_lines:-1
keybind = alt+e=scroll_page_lines:1
keybind = alt+u=scroll_page_fractional:-0.5
keybind = alt+d=scroll_page_fractional:0.5
keybind = alt+b=scroll_page_up
keybind = alt+f=scroll_page_down

# ── Toggles (symlinks managed by ghostty-retro and ghostty-shader-menu) ──
# Shader last so it replaces the retro one rather than stacking.
config-file = ?~/.config/ghostty/retro-on.conf
config-file = ?~/.config/ghostty/shader-on.conf
