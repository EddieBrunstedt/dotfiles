confirm-close-surface = false

font-family = "monospace"
font-size = 13

# Maple Mono's italic is a cursive with connecting entry/exit strokes, which
# runs letters together in italicised code (HTML attributes, comments, types).
# ss06 breaks those joins and keeps the slant; cv35 drops the looping tail on
# the italic l, which otherwise reads as a different letter entirely.
font-feature = ss06
font-feature = cv35

keybind = ctrl+enter=unbind

# Scrollback navigation
keybind = alt+y=scroll_page_lines:-1
keybind = alt+e=scroll_page_lines:1
keybind = alt+u=scroll_page_fractional:-0.5
keybind = alt+d=scroll_page_fractional:0.5
keybind = alt+b=scroll_page_up
keybind = alt+f=scroll_page_down

quit-after-last-window-closed = false

resize-overlay = never

scrollback-limit = 50000000

theme = Flexoki Dark

window-decoration = none
window-padding-balance = true
window-padding-x = 3
window-padding-y = 3
