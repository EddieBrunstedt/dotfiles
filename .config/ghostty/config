font-family = "monospace"
font-size = 11

confirm-close-surface = false
quit-after-last-window-closed = true

gtk-titlebar = false
window-padding-x = 0
window-padding-y = 0
window-decoration = server

background = #000000

keybind = ctrl+enter=unbind
keybind = shift+enter=text:\n

gtk-custom-css = ./custom.css
