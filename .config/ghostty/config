command = zsh -c "$HOME/.scripts/tmux_init"

font-family = "MonoLisa"
font-size = 13

confirm-close-surface = false
quit-after-last-window-closed = true

gtk-adwaita = false
gtk-titlebar = false
window-padding-x = 0
window-padding-y = 0
window-decoration = server

config-file = themes/modus_vivendi

keybind = ctrl+enter=unbind
