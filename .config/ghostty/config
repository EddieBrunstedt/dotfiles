command = zsh -c "$HOME/.scripts/tmux_init"

font-family = "MonoLisa"
font-size = 15

confirm-close-surface = false
quit-after-last-window-closed = true

gtk-adwaita = false
gtk-titlebar = false
window-padding-x = 0
window-padding-y = 0
window-decoration = server

background = #1e1e1e

keybind = ctrl+enter=unbind

gtk-custom-css = ./custom.css
