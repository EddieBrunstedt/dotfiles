command = zsh -c "$HOME/.scripts/tmux_init" # Initialize tmux on boot

confirm-close-surface = false
font-size = 13
gtk-adwaita = false
gtk-titlebar = false
quit-after-last-window-closed = true
window-decoration = false
window-padding-x = 0
window-padding-y = 0

config-file = themes/modus_vivendi # Load theme config
