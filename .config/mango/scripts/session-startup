#!/usr/bin/env bash
# session-startup — launch apps and place each on its home tag, once.
#
# For each entry: launch the app, poll mango's IPC until its window(s) appear,
# and tagsilent-move each new window to its tag. Waiting for the window handles
# slow starters (Steam's splash); tagsilent keeps the current view put.
#
# One-shot placement, not a windowrule — ad-hoc relaunches during the day stay
# wherever you open them. Wired to exec-once in config.conf.
#
# Edit the list at the bottom: <appid-regex> <tag> <launch command...>

set -u
TIMEOUT=60          # give up waiting for a first window after this long
SETTLE=5            # keep catching further windows this long after the first
POLL=0.5            # seconds between IPC polls

# ids of currently-open windows whose appid matches the given regex
ids_for() {
  mmsg get all-clients 2>/dev/null \
    | jq -r --arg a "$1" '.clients[] | select(.appid|test($a)) | .id'
}

# launch_place <appid-regex> <tag> <cmd...>
launch_place() {
  local appid_re=$1 tag=$2; shift 2

  # snapshot windows of this appid already open, so we only move NEW ones
  local before=" "
  local id
  while read -r id; do [[ -n $id ]] && before="$before$id "; done < <(ids_for "$appid_re")

  # -t service, not the default scope: a scope runs in the foreground and would
  # block the polling loop below. Transient units land in app-graphical.slice
  # and inherit WAYLAND_DISPLAY from the systemd user environment.
  uwsm app -t service -- "$@" >/dev/null 2>&1

  local deadline=$((SECONDS + TIMEOUT))
  local moved=" "
  while (( SECONDS < deadline )); do
    while read -r id; do
      [[ -z $id ]] && continue
      case "$before" in *" $id "*) continue;; esac   # was already open — skip
      case "$moved"  in *" $id "*) continue;; esac   # already moved — skip
      mmsg dispatch tagsilent,"$tag",0 client,"$id" >/dev/null 2>&1
      moved="$moved$id "
      # First window placed: stop waiting out the full timeout, but linger
      # briefly so an app that opens several windows gets all of them.
      (( deadline > SECONDS + SETTLE )) && deadline=$((SECONDS + SETTLE))
    done < <(ids_for "$appid_re")
    sleep "$POLL"
  done
}

# ── startup layout ── each line runs in parallel ────────────────────────────
# appid regex is matched against the window's appid (see: mmsg get all-clients).
# ^…$ anchors it so e.g. a ghostty rule would not also grab the scratchpad.
#            appid regex   tag   command to launch
launch_place '^steam$'      4    steam                    &
launch_place '^Spotify$'    2    spotify                  &
launch_place '^vesktop$'    3    mullvad-exclude vesktop  &

wait
