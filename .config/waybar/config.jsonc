// -*- mode: jsonc -*-
{
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "mango/workspaces",
        "mango/layout",
        "mango/window"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/cpubusy",
        "custom/memory",
        "custom/routebps",
        "custom/protonmail",
        "custom/mullvad",
        "custom/volume",
        "custom/voxtype",
        "clock",
        "custom/dunst",
        "tray"
    ],

    "mango/workspaces": {
        "format": "{icon}",
        "hide-empty": true,
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "mango/layout": {
        "format": "[{symbol}]"
    },
    "mango/window": {
        "format": "{title}",
        "icon": false
    },

    "custom/cpubusy": {
        "exec": "cpubusy",
        "interval": 1,
        "tooltip": false
    },
    "custom/memory": {
        "exec": "memory",
        "interval": 5,
        "tooltip": false
    },
    "custom/routebps": {
        "exec": "routebps",
        "interval": 1,
        "tooltip": false
    },
    // Absolute path: ~/.cargo/bin/protonmail-status shadows this shim on an
    // interactive shell's PATH. Each tick costs two sops decryptions.
    "custom/protonmail": {
        "exec": "~/.local/bin/shims/protonmail-status",
        "interval": 60,
        "signal": 4,
        "on-click": "xdg-open https://mail.proton.me/",
        "tooltip": false
    },
    "custom/mullvad": {
        "exec": "mullvad-status",
        "interval": 30,
        "signal": 2,
        "on-click": "mullvad-menu",
        "tooltip": false
    },
    "custom/volume": {
        "exec": "volume",
        "interval": 10,
        "signal": 1,
        "on-click": "ghostty -e wiremix -s compat -v output",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+ && pkill -RTMIN+1 waybar",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%- && pkill -RTMIN+1 waybar",
        "tooltip": false
    },
    "custom/voxtype": {
        "exec": "voxtype status --follow --format json --extended",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "idle": "\uf130",
            "recording": "\uf111",
            "transcribing": "\uf110",
            "stopped": "\uf131"
        },
        "tooltip": true,
        "on-click": "systemctl --user start voxtype.service",
        "on-click-middle": "systemctl --user restart voxtype.service",
        "on-click-right": "systemctl --user stop voxtype.service"
    },
    "custom/dunst": {
        "exec": "dunst-status",
        "interval": 5,
        "signal": 3,
        "on-click": "dunst-toggle",
        "tooltip": false
    },
    "clock": {
        "interval": 1,
        "format": "⏰ {:%m-%d %a %H:%M}",
        "format-alt": "⏰ {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "spacing": 10
    }
}
