// -*- mode: jsonc -*-
{
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": ["mango/workspaces", "mango/layout", "mango/window"],
    "modules-center": [],
    "modules-right": [
        "custom/mem",
        "custom/net",
        "custom/inbox",
        "custom/claude",
        "custom/mullvad",
        "custom/volume",
        "custom/units",
        "custom/disk",
        "group/toggles",
        "clock",
        "tray"
    ],

    // ── Left ──

    "mango/workspaces": {
        "format": "{index}",
        "hide-empty": true,
        "overview-label": "◫",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "mango/layout": {
        "format": "[{symbol}]"
    },
    "mango/window": {
        "format": "{title}",
        "icon": false
    },

    // ── Right ──
    // telltale gauges stream a line per change, so they need no interval.

    "custom/mem": {
        "exec": "telltale-mem --watch --format waybar",
        "return-type": "json",
        "tooltip": true
    },
    "custom/net": {
        "exec": "telltale-net --watch --format waybar",
        "return-type": "json",
        "tooltip": true
    },
    // Full path so it never falls through to the unshimmed binary.
    // --insecure: Bridge's cert is self-signed (telltale only allows it on loopback).
    "custom/inbox": {
        "exec": "~/.local/bin/shims/telltale-inbox --watch --format waybar --server imap://127.0.0.1:1143 --insecure --user-env PROTON_BRIDGE_IMAP_USER --password-env PROTON_BRIDGE_IMAP_PASS",
        "return-type": "json",
        "on-click": "xdg-open https://mail.proton.me/",
        "tooltip": true
    },
    "custom/claude": {
        "exec": "telltale-claude --watch --format waybar --floor normal",
        "return-type": "json",
        "on-click": "claude-menu",
        "tooltip": true
    },
    "custom/mullvad": {
        "exec": "mullvad-status",
        "return-type": "json",
        "on-click": "mullvad-menu",
        "tooltip": true
    },
    "custom/volume": {
        "exec": "volume",
        "return-type": "json",
        "interval": 10,
        "signal": 1,
        "on-click": "ghostty -e wiremix -s compat -v output",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+ && pkill -RTMIN+1 waybar",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%- && pkill -RTMIN+1 waybar",
        "tooltip": false
    },
    "custom/units": {
        "exec": "telltale-units --watch --format waybar --floor attention",
        "return-type": "json",
        "tooltip": true,
        "on-click": "ghostty -e sh -c 'systemctl --failed; systemctl --user --failed; read -r _'",
        "on-click-right": "systemctl --user reset-failed"
    },
    "custom/disk": {
        "exec": "telltale-disk --watch --format waybar --floor attention",
        "return-type": "json",
        "tooltip": true
    },

    // ── Toggles (one shared pill) ──

    "group/toggles": {
        "orientation": "horizontal",
        "modules": [
            "custom/voxtype",
            "custom/desktop",
            "custom/whitetemp",
            "custom/dunst"
        ]
    },
    // nf-md microphone, record, loading, microphone_off
    "custom/voxtype": {
        "exec": "voxtype status --follow --format json --extended",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "idle": "\udb80\udf6c",
            "recording": "\udb81\udc4a",
            "transcribing": "\udb81\udf72",
            "stopped": "\udb80\udf6d"
        },
        "tooltip": true,
        "on-click": "systemctl --user start voxtype.service",
        "on-click-middle": "systemctl --user restart voxtype.service",
        "on-click-right": "systemctl --user stop voxtype.service"
    },
    "custom/desktop": {
        "exec": "telltale-desktop --watch --format waybar",
        "return-type": "json",
        "on-click": "xdg-open ~/desktop",
        "tooltip": true
    },
    // Signalled by whitetemp; the interval is a fallback.
    "custom/whitetemp": {
        "exec": "whitetemp-status",
        "interval": 30,
        "signal": 5,
        "on-click": "whitetemp",
        "on-click-right": "systemctl --user stop whitetemp.service; pkill -RTMIN+5 waybar",
        "tooltip": false
    },
    "custom/dunst": {
        "exec": "dunst-status",
        "return-type": "json",
        "interval": 5,
        "signal": 3,
        "on-click": "dunst-toggle",
        "on-click-right": "dunst-history",
        "tooltip": true
    },

    // Tooltip fields need {0:...}: a bare {:...} asks for a second argument.
    "clock": {
        "interval": 60,
        "format": "{:%a %d %H:%M}",
        "tooltip-format": "{0:%F, week %V}\n<tt><small>{calendar}</small></tt>",
        "on-click": "xdg-open https://calendar.proton.me/"
    },
    "tray": {
        "spacing": 10
    }
}
