// -*- mode: jsonc -*-
{
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": ["mango/workspaces", "mango/layout", "mango/window"],
    "modules-center": [],
    "modules-right": [
        "custom/mem",
        "custom/net",
        "custom/inbox",
        "custom/claude",
        "custom/mullvad",
        "custom/volume",
        "custom/units",
        "custom/disk",
        "group/toggles",
        "clock",
        "tray"
    ],

    // {index} rather than {icon}: with no format-icons map, {icon} silently
    // falls back to the index anyway. Digits are kept because they name the
    // SUPER+1..9 binding that reaches each tag; state is expressed in CSS.
    // ◫ for the overview button because Maple Mono (the monospace font
    // style.css asks for) covers it natively, so the bar does not switch fonts
    // mid-row (the default label is "OVERVIEW").
    "mango/workspaces": {
        "format": "{index}",
        "hide-empty": true,
        "overview-label": "◫",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "mango/layout": {
        "format": "[{symbol}]"
    },
    "mango/window": {
        "format": "{title}",
        "icon": false
    },

    // telltale gauges (~/projects/telltale). No interval: each runs for as
    // long as the bar does and prints a new line only when the reading
    // changes. The class is the reading's level; style.css colours the levels.
    "custom/mem": {
        "exec": "telltale-mem --watch --format waybar",
        "return-type": "json",
        "tooltip": true
    },
    "custom/net": {
        "exec": "telltale-net --watch --format waybar",
        "return-type": "json",
        "tooltip": true
    },
    // Off the bar while nothing has failed. telltale-units asks systemd every
    // 30 s, so a reset-failed takes up to that long to clear the segment.
    "custom/units": {
        "exec": "telltale-units --watch --format waybar --floor attention",
        "return-type": "json",
        "tooltip": true,
        "on-click": "ghostty -e sh -c 'systemctl --failed; systemctl --user --failed; read -r _'",
        "on-click-right": "systemctl --user reset-failed"
    },
    // The floor keeps it off the bar until a filesystem is 90% full: below
    // that, the fullest disk is not something to act on.
    "custom/disk": {
        "exec": "telltale-disk --watch --format waybar --floor attention",
        "return-type": "json",
        "tooltip": true
    },
    // Absolute path, although the shims directory is currently first on the
    // session PATH: the bare name would fall through to the real binary in
    // ~/.cargo/bin, without its credentials, if that ordering ever changed.
    // The secrets are decrypted once per waybar start; Bridge then pushes
    // changes over IMAP IDLE. --insecure because Bridge's certificate is
    // self-signed; telltale refuses it for anything but a loopback address.
    // No floor: the inbox is a todo list, and an empty one (grey 0) is worth
    // seeing too.
    "custom/inbox": {
        "exec": "~/.local/bin/shims/telltale-inbox --watch --format waybar --server imap://127.0.0.1:1143 --insecure --user-env PROTON_BRIDGE_IMAP_USER --password-env PROTON_BRIDGE_IMAP_PASS",
        "return-type": "json",
        "on-click": "xdg-open https://mail.proton.me/",
        "tooltip": true
    },
    // Claude Code sessions. Off the bar while none is open; otherwise the
    // working ones by the robot and the idle ones by the sleep sign, peach
    // while one waits on you (a permission prompt or a question). A click
    // opens a rofi menu of the tooltip's rows; picking one focuses its window.
    "custom/claude": {
        "exec": "telltale-claude --watch --format waybar --floor normal",
        "return-type": "json",
        "on-click": "claude-menu",
        "tooltip": true
    },
    // No interval: mullvad-status streams the daemon's state changes, so
    // mullvad-menu has nothing to signal.
    "custom/mullvad": {
        "exec": "mullvad-status",
        "return-type": "json",
        "on-click": "mullvad-menu",
        "tooltip": true
    },
    "custom/volume": {
        "exec": "volume",
        "return-type": "json",
        "interval": 10,
        "signal": 1,
        "on-click": "ghostty -e wiremix -s compat -v output",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+ && pkill -RTMIN+1 waybar",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%- && pkill -RTMIN+1 waybar",
        "tooltip": false
    },
    // The icon-only segments, which are switches rather than readings, share
    // one pill in style.css instead of each drawing a tile of its own.
    "group/toggles": {
        "orientation": "horizontal",
        "modules": [
            "custom/voxtype",
            "custom/desktop",
            "custom/whitetemp",
            "custom/dunst"
        ]
    },

    // Material Design icons (nf-md-microphone, record, loading,
    // microphone_off), like the rest of the bar. Their ink spills at most a
    // quarter cell past the advance, inside the 6px padding; the Font
    // Awesome ones used before spilled nearly a cell and were clipped.
    "custom/voxtype": {
        "exec": "voxtype status --follow --format json --extended",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "idle": "\udb80\udf6c",
            "recording": "\udb81\udc4a",
            "transcribing": "\udb81\udf72",
            "stopped": "\udb80\udf6d"
        },
        "tooltip": true,
        "on-click": "systemctl --user start voxtype.service",
        "on-click-middle": "systemctl --user restart voxtype.service",
        "on-click-right": "systemctl --user stop voxtype.service"
    },

    // ~/desktop is the scratch drawer and is meant to be empty between
    // projects; this segment is the standing reminder that it is not. It never
    // hides, unlike whitetemp: a missing segment reads as a dead module rather
    // than as "nothing to do". Three classes come back on stdout -- clean,
    // fresh, and stale for a mess that outlived a reboot -- and style.css
    // colours them; see desktop-status for how the boot is detected. Both
    // tray glyphs are the same width so the clock does not shift when the
    // state flips, which is why the count lives in the tooltip. desktop-watch
    // signals RTMIN+6 on every change, so the interval is only a safety net
    // for that unit dying behind waybar's back.
    "custom/desktop": {
        "exec": "desktop-status",
        "return-type": "json",
        "interval": 30,
        "signal": 6,
        "on-click": "xdg-open ~/desktop",
        "tooltip": true
    },

    // Prints nothing while the screen is neutral, so the segment is absent
    // rather than idle. The interval is only a safety net for the unit dying
    // behind waybar's back; whitetemp signals RTMIN+5 on every change.
    "custom/whitetemp": {
        "exec": "whitetemp-status",
        "interval": 30,
        "signal": 5,
        "on-click": "whitetemp",
        "on-click-right": "systemctl --user stop whitetemp.service; pkill -RTMIN+5 waybar",
        "tooltip": false
    },
    "custom/dunst": {
        "exec": "dunst-status",
        "return-type": "json",
        "interval": 5,
        "signal": 3,
        "on-click": "dunst-toggle",
        "on-click-right": "dunst-history",
        "tooltip": true
    },
    // Fixed width: %a and %d are always three and two characters. Waybar
    // aligns the interval to the minute, so 60 changes the text on time. The
    // full date and ISO week are in the tooltip rather than a format-alt.
    // The tooltip is formatted with the time as its only argument, so each
    // field names it as {0:...}: a bare {:...} takes the next argument, and the
    // second one would ask for an argument that does not exist.
    "clock": {
        "interval": 60,
        "format": "{:%a %d %H:%M}",
        "tooltip-format": "{0:%F, week %V}\n<tt><small>{calendar}</small></tt>",
        "on-click": "xdg-open https://calendar.proton.me/"
    },

    "tray": {
        "spacing": 10
    }
}
