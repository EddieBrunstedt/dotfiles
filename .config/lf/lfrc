# Eddie's lf settings

# Basic vars
set shell sh
set previewer ~/.config/lf/preview
set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set color256 true
set icons true
set ignorecase true
set drawbox true

# Custom
set preview false
set nopreview
set ratios 1
set info size:time

# cmds/functions
cmd open ${{
    case $(file --mime-type "$f" -bL) in
       image/*) rotdir $f | setsid sxiv -aio 2>/dev/null | lf-select & ;;
       text/*|application/json) emacsclient -n "$f";;
       video/*|image/*/application/pdf) xdg-open "$f";;
       *) xdg-open "$f" ;;
    esac
}}

cmd rename %[ -e $1 ] && printf "file exists" || mv $f $1

cmd delete ${{
    set -f
    printf "%s\n\t" "$fx"
    printf "delete? [y/N] "
    read ans
    [ $ans = "y" ] && rm -rf $fx
}}

cmd nopreview &{{
    lf -remote "send $id set nopreview"
    lf -remote "send $id set ratios 1"
}}

cmd viewpreview &{{
    lf -remote "send $id set ratios 1:1"
    lf -remote "send $id set preview"
}}

# Bindings
map <c-f> $lf -remote "send $id select '$(fzf)'"
map J $lf -remote "send $id cd $(cut -d'	' -f2 ~/.config/directories | fzf)"
map D delete
map a push %mkdir<space>
map R push :rename<space>
map r $lf -remote "send $id push :rename<space>$f"
map <c-r> reload
map <enter> shell
map x $$f
map X !$f
map o &mimeopen $f
map O $mimeopen --ask $f
map zp viewpreview
map zo nopreview
