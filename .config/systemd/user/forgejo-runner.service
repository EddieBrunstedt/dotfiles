# User units can't depend on system units (docker.service, network-online.target),
# so Restart= covers starting before DNS is up. Enable docker separately.
[Unit]
Description=Forgejo Actions runner (Codeberg)

[Service]
Type=simple
# Not app-graphical.slice: started via linger, must outlive the session.
Slice=background.slice
WorkingDirectory=%h/.config/forgejo-runner
ExecStart=/usr/bin/forgejo-runner daemon \
  --url https://codeberg.org/ \
  --uuid fa725fda-6407-4dfe-af0e-12907ae515c2 \
  --token-url file://%h/.config/forgejo-runner/runner-token \
  --label docker:docker://node:24-trixie \
  --label native:host
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
