[Unit]
Description=Forgejo Actions runner (Codeberg)
# No After=/Wants= on docker.service or network-online.target: those are SYSTEM
# units and this is a USER unit, so systemd silently ignores the dependency
# (`systemctl --user show` still echoes it back, which makes it look effective).
# User units cannot order against system units at all. At boot this daemon may
# start before DNS resolves; Restart=on-failure below recovers it in ~5s.
# The system-side docker.service must be enabled separately -- see README.

[Service]
Type=simple
# Deliberately NOT app.slice: that slice is bound to graphical-session.target
# (see app.slice.d/graphical.conf), so anything in it dies on Mango logout.
# This runner starts at boot via Linger=yes and must outlive the compositor.
Slice=background.slice
WorkingDirectory=%h/.config/forgejo-runner
ExecStart=/usr/bin/forgejo-runner daemon \
  --url https://codeberg.org/ \
  --uuid fa725fda-6407-4dfe-af0e-12907ae515c2 \
  --token-url file://%h/.config/forgejo-runner/runner-token \
  --label docker:docker://node:20-bookworm \
  --label native:host
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
