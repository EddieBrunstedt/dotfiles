[Unit]
Description=Proton Mail Bridge
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do { ! systemctl is-enabled --quiet mullvad-daemon.service 2>/dev/null || mullvad status 2>/dev/null | head -1 | grep -qE "^(Tunnel status: )?Connected$"; } && curl -sm 2 -o /dev/null https://mail-api.proton.me/ && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/protonmail-bridge-core --noninteractive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
