[Unit]
Description=Session lock on request and before sleep (swayidle)
Documentation=man:swayidle(1)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "mango" ""
# No idle timeout: locking is always deliberate. before-sleep is a backstop;
# suspend is disabled system-wide.
ExecStart=/usr/bin/swayidle -w \
  lock '%h/.local/bin/lock-screen -f' \
  before-sleep '%h/.local/bin/lock-screen -f'
Restart=on-failure
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
