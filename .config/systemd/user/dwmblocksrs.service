[Unit]
Description=dwm status bar
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Environment=PATH=%h/.local/bin/statusbar:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin
EnvironmentFile=-%h/.secrets/env
ExecStart=%h/.cargo/bin/dwmblocksrs
Restart=on-failure

[Install]
WantedBy=graphical-session.target
