[Unit]
Description=org.freedesktop.FileManager1 provider (opens the mimeapps default)
Documentation=https://freedesktop.org/wiki/Specifications/file-manager-interface
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.FileManager1
ExecStart=%h/.local/bin/filemanager-yazi
Slice=app-graphical.slice
# Exits when idle; the next D-Bus call re-activates it.
Restart=no
