# Commit list on the left, diff on the right with most of the width
set vertical-split = yes
set split-view-width = 70%

# Highlight the changed words inside changed lines
set diff-highlight = /usr/share/git/diff-highlight/diff-highlight
set tab-size = 2

# Colours follow the [delta] section in ~/.gitconfig. tig only takes
# 256-colour numbers, so these are the nearest matches to its hex values.
color diff-add            default 22
color diff-del            default 52
color diff-add-highlight  default 28  bold
color diff-del-highlight  default 88  bold
color diff-header         111 default bold
color "--- "              60  default
color "+++ "              60  default
color diff-index          60  default
color diff-chunk          60  default
color diff-stat           111 default
color "commit "           179 default bold
color cursor              default 237 bold
color cursor-blur         default 236

# V: open the selected commit in delta
bind generic V !git show %(commit)
