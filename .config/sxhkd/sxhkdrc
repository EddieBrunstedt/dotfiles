# Shutdown computer
super + shift + x
	prompt "Shutdown computer?" "sudo -A shutdown -h now"
# Reboot computer
super + shift + BackSpace
	prompt "Reboot computer?" "sudo -A shutdown -r now"
# Hibernate computer
super + F4
	prompt 'Hibernate computer?' 'sudo systemctl suspend'
# Lock computer
super + shift + l
	gpgconf --reload gpg-agent; betterlockscreen -l dimblur -t "Can't touch this na na na na"

# Monitor backlight brightness
XF86MonBrightnessDown
	xbacklight -dec 15
XF86MonBrightnessUp
	xbacklight -inc 15

# Take screenshot
Print
	maim pic-full-$(date '+%y%m%d-%H%M-%S').png
# Pick screenshot type
shift + Print
	maimpick

# Choose display
super + F3
	displayselect

# Mount a USB drive or Android device
super + F9
	dmenumount

# Unmount a USB drive or Android device
super + F10
	dmenuumount

# Search with Duckduckgo
super + F11
	ducksearch

# Network Manager interface
super + F12
	$TERMINAL -e sudo -A nmtui

# Set White Temperature
super + shift + r
	whitetemp

# Run org-capture
super + shift + n
	org-capture

# Open terminal with pulsemixer
super + shift + p
	start-pulsemixer

# Toggle VPN on
super + shift + F5
	prompt "Turn ON Mullvad VPN?" "sudo wg-quick up mullvad"

# Toggle VPN off
super + shift + F6
	prompt "Turn OFF Mullvad VPN?" "sudo wg-quick down mullvad"

# Gaming Monitor xrandr settings
# super + shift + F1
    # xrandr --output DP-4 --mode 3440x1440 --rate 99.98

# Ultra widea xrandr settings
super + shift + F2
    xrandr --output DP-4 --mode 3440x1440 --rate 99.98

# Volume
super + bracketright
    pamixer -i 5
super + bracketleft
    pamixer -d 5
