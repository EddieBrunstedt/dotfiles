super + e
	$BROWSER
super + shift + f
	$TERMINAL -e tmux new -A -s file-manager "lf"
super + shift + a
	$TERMINAL -e tmux new -A -s pulsemixer "pulsemixer"
super + shift + v
	mpv --force-window --idle

super + shift + m
	monitor-setting
super + shift + p
	ord_prompts
super + shift + i
	dunstctl close-all
super + shift + b
	whitetemp
super + shift + k
	keyboard-layout-dmenu
super + shift + n
	$TERMINAL -e nmtui

# Volume
XF86AudioRaiseVolume
	pamixer -i 5
XF86AudioLowerVolume
	pamixer -d 5

super + shift + l
	gpgconf --reload gpg-agent; betterlockscreen -l;

# Monitor backlight brightness
XF86MonBrightnessDown
	light -U 10
XF86MonBrightnessUp
	light -A 10

# Make screenshot (screen with mouse pointer)
Print
	flameshot gui -c -p ~/media/image/screenshots

# Make screenshot (using gui)
shift + Print
	flameshot screen -c -p ~/media/image/screenshots

# Mount a USB drive or Android device
super + F9
	dmenumount

# Unmount a USB drive or Android device
super + F10
	dmenuumount
