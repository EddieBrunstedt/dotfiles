super + e
    spawn $BROWSER
super + shift + f
    spawn $TERMINAL -e tmux new -A -s file-manager "yazi"
super + shift + a
    spawn $TERMINAL -e tmux new -A -s pulsemixer "pulsemixer"
super + shift + v
    spawn mpv --force-window --idle

super + shift + m
    spawn monitor-setting
super + shift + p
    spawn env SHELL=/usr/bin/sh ord_prompts
super + shift + i
    dunstctl close-all
super + shift + b
    spawn whitetemp
super + shift + k
    spawn keyboard-layout-dmenu
super + shift + n
    spawn $TERMINAL -e nmtui

# Volume
XF86AudioRaiseVolume
    pamixer -i 5 && pkill -x -RTMIN+1 dwmblocksrs
XF86AudioLowerVolume
    pamixer -d 5 && pkill -x -RTMIN+1 dwmblocksrs
XF86AudioMute
    pamixer -t && pkill -x -RTMIN+1 dwmblocksrs

super + shift + l
    spawn betterlockscreen -l --text "U Can't Touch This, nananana"

super + shift + x
    spawn sys

# Monitor backlight brightness
XF86MonBrightnessDown
    light -U 10
XF86MonBrightnessUp
    light -A 10

# Make screenshot (screen with mouse pointer)
Print
    spawn flameshot gui -c -p ~/screenshots


# Make screenshot (using gui)
shift + Print
    spawn flameshot screen -c -p ~/screenshots

# Mount a USB drive or Android device
super + F9
    spawn dmenumount

# Unmount a USB drive or Android device
super + F10
    spawn dmenuumount
