# Shortcuts
super + shift + e
	$BROWSER
super + shift + f
	$TERMINAL -e $FILE

# Set White Temperature
super + shift + r
	whitetemp

# Volume
XF86AudioRaiseVolume
    pamixer -i 5
XF86AudioLowerVolume
    pamixer -d 5

# Lock/Reboot/Power off computer
super + shift + y
	afk

# Monitor backlight brightness
XF86MonBrightnessDown
	xbacklight -dec 15
XF86MonBrightnessUp
	xbacklight -inc 15

# Make screenshot (screen with mouse pointer)
Print
	flameshot gui -c -p ~/screenshots/

# Make screenshot (using gui)
shift + Print
	flameshot screen -c -p ~/screenshots/

# Mount a USB drive or Android device
super + F9
	dmenumount

# Unmount a USB drive or Android device
super + F10
	dmenuumount

# Network Manager interface
super + F12
	$TERMINAL -e nmtui

# Run org-capture
super + shift + n
	org-capture

# Open terminal with pulsemixer
super + shift + p
	alacritty -e pulsemixer

# Keyboard Layout
super + shift + k
	keyboard-layout-dmenu

# Lookup what's in the clipboard
super + shift + l
	lookup
