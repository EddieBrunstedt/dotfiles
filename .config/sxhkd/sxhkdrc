super + e
    exec $BROWSER
super + shift + f
    $TERMINAL -e tmux new -A -s file-manager "yazi"
super + shift + a
    $TERMINAL -e tmux new -A -s pulsemixer "pulsemixer"
super + shift + v
    mpv --force-window --idle

super + shift + m
    monitor-setting
super + shift + p
    SHELL=/usr/bin/sh ord_prompts
super + shift + i
    dunstctl close-all
super + shift + b
    whitetemp
super + shift + k
    keyboard-layout-dmenu
super + shift + n
    $TERMINAL -e nmtui

# Volume
XF86AudioRaiseVolume
    pamixer -i 5 && pkill -x -RTMIN+1 dwmblocksrs
XF86AudioLowerVolume
    pamixer -d 5 && pkill -x -RTMIN+1 dwmblocksrs
XF86AudioMute
    pamixer -t && pkill -x -RTMIN+1 dwmblocksrs

super + shift + l
    gpgconf --reload gpg-agent; gpg-connect-agent 'clear_passphrase' /bye; betterlockscreen -l &

super + shift + x
    sys;

# Monitor backlight brightness
XF86MonBrightnessDown
    light -U 10
XF86MonBrightnessUp
    light -A 10

# Make screenshot (screen with mouse pointer)
Print
    flameshot gui -c -p ~/screenshots


# Make screenshot (using gui)
shift + Print
    flameshot screen -c -p ~/screenshots

# Mount a USB drive or Android device
super + F9
    dmenumount

# Unmount a USB drive or Android device
super + F10
    dmenuumount
