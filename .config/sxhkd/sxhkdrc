# Shortcuts
super + shift + e
	$BROWSER
super + shift + f
	$TERMINAL -e $FILE

# Set White Temperature
super + shift + r
	whitetemp

# Volume
XF86AudioRaiseVolume
    pamixer -i 5
XF86AudioLowerVolume
    pamixer -d 5

# Shutdown computer
super + shift + x
	prompt "Shutdown computer?" "sudo -A shutdown -h now"
# Reboot computer
super + shift + BackSpace
	prompt "Reboot computer?" "sudo -A shutdown -r now"
# Hibernate computer
super + F4
	prompt 'Hibernate computer?' 'sudo systemctl suspend'
# Lock computer
super + shift + l
	gpgconf --reload gpg-agent; betterlockscreen -l dimblur -t "Can't touch this na na na na"

# Monitor backlight brightness
XF86MonBrightnessDown
	xbacklight -dec 15
XF86MonBrightnessUp
	xbacklight -inc 15

# Make screenshot
Print
	maim pic-full-$(date '+%y%m%d-%H%M-%S').png
# Make screenshot (pick type)
shift + Print
	maimpick

# Mount a USB drive or Android device
super + F9
	dmenumount

# Unmount a USB drive or Android device
super + F10
	dmenuumount

# Network Manager interface
super + F12
	$TERMINAL -e nmtui

# Run org-capture
super + shift + n
	org-capture

# Open terminal with pulsemixer
super + shift + p
	start-pulsemixer

# Keyboard Layout
super + F1
	setxkbmap -layout us -option caps:super
super + F2
	setxkbmap -layout se -option caps:super
super + F3
	setxkbmap -layout dk -option caps:super
