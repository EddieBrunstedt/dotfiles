# Shortcuts
super + shift + e
	  emacsclient -c -a 'emacs'
super + e
	  $BROWSER
super + r
	  $TERMINAL -e tmux new -A -s file-manager 'lf'
super + shift + r
	  $TERMINAL -e tmux new -A -s file-manager 'lf $(find ~/ -type d | fzf)';
super + shift + v
	  mpv --force-window --idle;
super + shift + m
	  monitor-setting

# Set White Temperature
super + shift + b
	whitetemp

# Volume
XF86AudioRaiseVolume
	pamixer -i 5
XF86AudioLowerVolume
    pamixer -d 5

super + shift + l
    gpgconf --reload gpg-agent; betterlockscreen -l;

# Monitor backlight brightness
XF86MonBrightnessDown
	light -U 10
XF86MonBrightnessUp
	light -A 10

# Make screenshot (screen with mouse pointer)
Print
	flameshot gui -c -p ~/media/image/screenshots

# Make screenshot (using gui)
shift + Print
	flameshot screen -c -p ~/media/image/screenshots

# Mount a USB drive or Android device
super + F9
	dmenumount

# Unmount a USB drive or Android device
super + F10
	dmenuumount

# Network Manager interface
super + F12
	$TERMINAL -e nmtui

# Run org-capture
super + shift + n
	org-capture

# Open terminal with pulsemixer
super + shift + p
	$TERMINAL -e tmux new -A -s pulsemixer 'pulsemixer';

# Keyboard Layout
super + shift + k
	keyboard-layout-dmenu

# Lookup what's in the clipboard
super + S
	lookup

# Search on DuckDuckGo
super + s
	search

# Calculator
XF86Calculator
	$TERMINAL -e tmux new -A -s calculator 'bc -l';
