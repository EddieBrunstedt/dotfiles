! Font
*.font: monospace:pixelsize=14:antialias=true:autohint=true

! Cursor
Xcursor.theme: capitaine-cursors
Xcursor.size: 31

! nsxiv dark mode
Nsxiv.background: #1e1e1e
Nsxiv.foreground: #d4d4d4
Nsxiv.bar.background: #2d2d2d
Nsxiv.bar.foreground: #d4d4d4
Nsxiv.mark.foreground: #ff8800
Nsxiv.window.background: #1e1e1e
Nsxiv.window.foreground: #d4d4d4
