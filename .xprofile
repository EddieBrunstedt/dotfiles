#!/bin/sh

# Load .Xresources.
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# Set cursor on the root window (important for WMs like dwm)
xsetroot -cursor_name left_ptr

# Bind keys
sxhkd &

# Sets the statusbar in dwm
dwmblocks &

# Start nitrogen for wallpaper
nitrogen --restore &

# Set keyboard layout and set Caps as Mod/Escape
# setxkbmap -layout us,se,dk -option caps:super -option grp:alt_shift_toggle &

# Speed xrate up
xset r rate 300 50 &

# Remove mouse when idle
unclutter &

# picom for transparency
# picom -b &

# dunst for notifications
dunst &

# megasync for cloud storage
megasync &

# fuck you, bluetooth
#blueman-applet &

# Mullvad VPN
mullvad-vpn &

# emacs daemon for better emacs
emacs --daemon &

# ProtonMail Bridge
# protonmail-bridge &

# Laptop TouchPad settings
xinput set-prop 'SynPS/2 Synaptics TouchPad' 'libinput Accel Speed' 0.3
xinput set-prop 'SynPS/2 Synaptics TouchPad' 'libinput Tapping Enabled' 1
xinput set-prop "TPPS/2 Elan TrackPoint" 335 -0.5

# Disable monitor power saving
xset -dpms
xset s off
xset s noblank
