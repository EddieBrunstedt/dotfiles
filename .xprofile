#!/bin/sh

# Set the background
setbg &

# Bind keys
sxhkd &

# Sets the statusbar in dwm
slstatus &

# Set keyboard layout and set Caps as Mod/Escape
setxkbmap -layout us,se,dk &
setxkbmap -option caps:super &

# Speed xrate up
xset r rate 300 50 &

# Remove mouse when idle
unclutter &

# xcompmgr for transparency
#xcompmgr &

# dunst for notifications
dunst &

# megasync for cloud storage
megasync &

blueman-applet &
