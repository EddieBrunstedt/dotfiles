#!/bin/sh

# Load .Xresources.
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# X server configuration
xsetroot -cursor_name left_ptr # Set cursor on root window
xset r rate 200 50             # Keyboard repeat rate
xset -dpms                     # Disable monitor power saving
xset s off                     # Disable screensaver
xset s noblank                 # Prevent screen blanking

# Launch background services
sxhkd &              # Keybindings
dwmblocksrs &        # Status bar
nitrogen --restore & # Wallpaper
unclutter &          # Hide idle cursor
dunst &              # Notifications
megasync &           # Cloud storage
mullvad-vpn &        # VPN
