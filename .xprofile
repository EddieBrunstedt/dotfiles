#!/bin/sh

# Load .Xresources.
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# X server configuration
xsetroot -cursor_name left_ptr # Set cursor on root window
xset -dpms                     # Disable monitor power saving
xset s off                     # Disable screensaver
xset s noblank                 # Prevent screen blanking

# Hand off to user systemd; graphical-session.target activates everything else
systemctl --user import-environment DISPLAY XAUTHORITY PATH SHELL BROWSER TERMINAL EDITOR LANG
systemctl --user start --no-block dwm-session.target
