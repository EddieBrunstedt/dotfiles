#!/bin/sh

# Load .Xresources.
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"


xsetroot -cursor_name left_ptr	# Set cursor on the root window (important for WMs like dwm)
sxhkd &				# Keybindings
dwmblocksrs &			# statusbar in dwm
nitrogen --restore &		# Wallpaper
xset r rate 300 50 &		# Keyboard long-press/repeat speed
unclutter &			# Remove mouse cursor when idle
dunst &				# notifications
megasync &			# cloud storage syncing
mullvad-vpn &			# vpn

# Disable monitor power saving
xset -dpms
xset s off
xset s noblank
